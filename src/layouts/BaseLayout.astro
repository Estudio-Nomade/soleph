---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Lightbox from '../components/Lightbox.astro';
import ShopSelectBar from '../components/ShopSelectBar.astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Meta robots. Default: SEO on + señales noai. Tienda live: noindex. */
  robots?: string;
}

const {
  title = site.brand.name,
  description = `${site.brand.name} — ${site.brand.tagline}. ${site.brand.location}.`,
  ogImage = site.projects[0]?.cover || '/images/logo.png',
  robots = 'index, follow, noai, noimageai',
} = Astro.props;

const fullTitle = title === site.brand.name ? title : `${site.brand.name} - ${title}`;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#012B55" />
    <script define:vars={{ shopAlbums: site.shop.albums, seedPricing: site.shop.pricing || null, siteSeed: site }}>
      window.__SOLEPH_SHOP_ALBUMS__ = shopAlbums;
      window.__SOLEPH_SEED_PRICING__ = seedPricing;
      window.__SOLEPH_SITE_SEED__ = siteSeed;
    </script>
  </head>
  <body id="top" class="is-page-loading">
    <Header />
    <div class="site-wrap">
      <slot />
    </div>
    <Footer />
    <CartDrawer />
    <Lightbox />
    <ShopSelectBar />
    <script is:inline>
      (function () {
        var b = document.body;
        if (!b) return;
        function syncScrollRoom() {
          var room = document.documentElement.scrollHeight > window.innerHeight + 120;
          b.classList.toggle('has-scroll-room', room);
        }
        function reveal() {
          b.classList.remove('is-page-loading');
          syncScrollRoom();
        }
        if (document.readyState === 'complete') reveal();
        else window.addEventListener('load', reveal, { once: true });
        // Fallback si load tarda (imágenes pesadas): mostrar footer tras paint
        setTimeout(reveal, 900);
        window.addEventListener('pageshow', function (ev) {
          if (ev.persisted) {
            b.classList.remove('is-navigating', 'is-page-loading');
            syncScrollRoom();
          }
        });
        document.addEventListener(
          'click',
          function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
            if (!a) return;
            if (e.defaultPrevented || e.button !== 0) return;
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            if (a.target && a.target !== '' && a.target !== '_self') return;
            if (a.hasAttribute('download')) return;
            var href = a.getAttribute('href') || '';
            if (!href || href.charAt(0) === '#' || href.indexOf('mailto:') === 0 || href.indexOf('tel:') === 0)
              return;
            if (href.indexOf('javascript:') === 0) return;
            try {
              var url = new URL(a.href, window.location.href);
              if (url.origin !== window.location.origin) return;
              // mismo path+query: no es navegación real
              if (url.pathname === window.location.pathname && url.search === window.location.search) return;
            } catch (_) {
              return;
            }
            b.classList.add('is-navigating');
          },
          true,
        );
        window.addEventListener('pagehide', function () {
          b.classList.add('is-navigating');
        });
        var t;
        window.addEventListener(
          'scroll',
          function () {
            clearTimeout(t);
            t = setTimeout(syncScrollRoom, 80);
          },
          { passive: true },
        );
        window.addEventListener('resize', function () {
          clearTimeout(t);
          t = setTimeout(syncScrollRoom, 80);
        });
        if (typeof ResizeObserver !== 'undefined') {
          try {
            new ResizeObserver(function () {
              clearTimeout(t);
              t = setTimeout(syncScrollRoom, 60);
            }).observe(document.documentElement);
          } catch (_) {}
        }
      })();
    </script>
    <script>
      import '../scripts/image-guard.js';
    </script>
  </body>
</html>
