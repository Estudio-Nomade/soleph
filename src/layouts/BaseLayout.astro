---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Lightbox from '../components/Lightbox.astro';
import ShopSelectBar from '../components/ShopSelectBar.astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Meta robots. Default: SEO on + señales noai. Tienda live: noindex. */
  robots?: string;
}

const {
  title = site.brand.name,
  description = `${site.brand.name} — ${site.brand.tagline}. ${site.brand.location}.`,
  ogImage = site.projects[0]?.cover || '/images/logo.png',
  robots = 'index, follow, noai, noimageai',
} = Astro.props;

const fullTitle = title === site.brand.name ? title : `${site.brand.name} - ${title}`;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#012B55" />
    <script define:vars={{ shopAlbums: site.shop.albums, seedPricing: site.shop.pricing || null, siteSeed: site }}>
      window.__SOLEPH_SHOP_ALBUMS__ = shopAlbums;
      window.__SOLEPH_SEED_PRICING__ = seedPricing;
      window.__SOLEPH_SITE_SEED__ = siteSeed;
    </script>
  </head>
  <body id="top">
    <Header />
    <div class="site-wrap">
      <slot />
    </div>
    <Footer />
    <CartDrawer />
    <Lightbox />
    <ShopSelectBar />
    <script>
      import '../scripts/image-guard.js';
    </script>
  </body>
</html>
