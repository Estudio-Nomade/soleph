---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Lightbox from '../components/Lightbox.astro';
import ShopSelectBar from '../components/ShopSelectBar.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Meta robots. Default: SEO on + señales noai. Tienda live: noindex. */
  robots?: string;
  /** LCP image path (e.g. hero). Preload + high priority. */
  lcpImage?: string;
  /** Optional mobile LCP src for srcset consumers; also preloaded as image. */
  lcpImageMobile?: string;
}

const {
  title = site.brand.name,
  description = `${site.brand.name} — ${site.brand.tagline}. ${site.brand.location}.`,
  ogImage = site.projects[0]?.cover || '/images/logo.png',
  robots = 'index, follow, noai, noimageai',
  lcpImage,
  lcpImageMobile,
} = Astro.props;

const fullTitle = title === site.brand.name ? title : `${site.brand.name} - ${title}`;

// Slim globals: no full photo arrays on every page (LCP/FCP parse cost).
const shopAlbumsLite = (site.shop.albums || []).map((a) => ({
  id: a.id,
  name: a.name,
  kind: a.kind || 'event',
  date_label: a.date_label || null,
  cover: a.cover,
  photo_count: a.photo_count || (Array.isArray(a.photos) ? a.photos.length : 0),
  photo_price: a.photo_price,
  price_tiers: a.price_tiers || [],
  message: a.message || null,
  search_by_face: a.search_by_face === true,
  search_by_number: a.search_by_number === true,
}));

const siteSeedLite = {
  brand: site.brand,
  about: site.about
    ? {
        title: site.about.title,
        body: site.about.body,
        image: site.about.image,
      }
    : null,
  nav: site.nav,
  projects: (site.projects || []).map((p) => ({
    id: p.id,
    slug: p.slug || p.id,
    title: p.title || p.name,
    name: p.name || p.title,
    year: p.year || p.date_label || null,
    cover: p.cover,
    summary: p.summary || p.excerpt || null,
  })),
  shop: {
    currencySymbol: site.shop.currencySymbol,
    pricing: site.shop.pricing || null,
    albums: shopAlbumsLite,
    portfolio_intro: site.shop.portfolio_intro,
    events_title: site.shop.events_title,
    portfolio_title: site.shop.portfolio_title,
    events_empty: site.shop.events_empty,
    intro: site.shop.intro,
  },
};

const mediaBase = (import.meta.env.PUBLIC_MEDIA_BASE_URL || '').replace(/\/$/, '');
const supabaseBase = (import.meta.env.PUBLIC_SUPABASE_URL || '').replace(/\/$/, '');
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#012B55" />
    {mediaBase ? <link rel="preconnect" href={mediaBase} crossorigin /> : null}
    {supabaseBase ? <link rel="preconnect" href={supabaseBase} crossorigin /> : null}
    {supabaseBase ? <link rel="dns-prefetch" href={supabaseBase} /> : null}
    {
      lcpImageMobile ? (
        <link rel="preload" as="image" href={lcpImageMobile} type="image/jpeg" media="(max-width: 932px)" />
      ) : null
    }
    {
      lcpImage ? (
        <link
          rel="preload"
          as="image"
          href={lcpImage}
          type="image/jpeg"
          media={lcpImageMobile ? '(min-width: 933px)' : undefined}
        />
      ) : null
    }
    <script
      define:vars={{
        shopAlbums: shopAlbumsLite,
        seedPricing: site.shop.pricing || null,
        siteSeed: siteSeedLite,
      }}
    >
      window.__SOLEPH_SHOP_ALBUMS__ = shopAlbums;
      window.__SOLEPH_SEED_PRICING__ = seedPricing;
      window.__SOLEPH_SITE_SEED__ = siteSeed;
    </script>
  </head>
  <body id="top" class="is-page-loading">
    <Header />
    <div class="site-wrap">
      <slot />
    </div>
    <Footer />
    <CartDrawer />
    <Lightbox />
    <ShopSelectBar />
    <script is:inline>
      (function () {
        var b = document.body;
        if (!b) return;
        function reveal() {
          b.classList.remove('is-page-loading');
        }
        // Prefer first paint over waiting every image (LCP/FCP). Keep short fallback.
        if (document.readyState === 'interactive' || document.readyState === 'complete') {
          requestAnimationFrame(function () {
            requestAnimationFrame(reveal);
          });
        } else {
          document.addEventListener(
            'DOMContentLoaded',
            function () {
              requestAnimationFrame(function () {
                requestAnimationFrame(reveal);
              });
            },
            { once: true },
          );
        }
        setTimeout(reveal, 400);
        window.addEventListener('pageshow', function (ev) {
          if (ev.persisted) b.classList.remove('is-navigating', 'is-page-loading');
        });
        document.addEventListener(
          'click',
          function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
            if (!a) return;
            if (e.defaultPrevented || e.button !== 0) return;
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            if (a.target && a.target !== '' && a.target !== '_self') return;
            if (a.hasAttribute('download')) return;
            var href = a.getAttribute('href') || '';
            if (!href || href.charAt(0) === '#' || href.indexOf('mailto:') === 0 || href.indexOf('tel:') === 0)
              return;
            if (href.indexOf('javascript:') === 0) return;
            try {
              var url = new URL(a.href, window.location.href);
              if (url.origin !== window.location.origin) return;
              if (url.pathname === window.location.pathname && url.search === window.location.search) return;
            } catch (_) {
              return;
            }
            b.classList.add('is-navigating');
          },
          true,
        );
        window.addEventListener('pagehide', function () {
          b.classList.add('is-navigating');
        });
      })();
    </script>
    <script>
      import '../scripts/image-guard.js';
    </script>
    <!-- Web Analytics + Core Web Vitals (Vercel dashboard → Analytics / Speed Insights) -->
    <Analytics />
    <SpeedInsights />
  </body>
</html>
