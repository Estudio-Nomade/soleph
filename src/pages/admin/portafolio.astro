---
import AdminLayout from '../../layouts/AdminLayout.astro';
import site from '../../data/site.json';
---

<AdminLayout title="Portafolio">
  <div data-admin-portfolio>
    <div class="admin-head">
      <div>
        <h1>Portafolio y Sobre mí</h1>
        <p>Textos y fotos de Trabajos / proyectos / Sobre mí. Se publican al guardar (sin redeploy).</p>
      </div>
      <div class="admin-actions">
        <a class="admin-btn admin-btn--ghost" href="/admin">Volver</a>
        <button type="button" class="admin-btn" data-save>Guardar todo</button>
      </div>
    </div>

    <p class="admin-msg admin-msg--error" data-error hidden></p>
    <p class="admin-msg admin-msg--ok" data-ok hidden></p>
    <p class="admin-msg admin-msg--info" data-loading>Cargando…</p>

    <div data-ready hidden>
      <div class="admin-card">
        <h2 class="admin-section-title">Textos de la tienda</h2>
        <p class="admin-muted" style="margin-top:0">
          Mensaje arriba de las fotos (ej. LA MAKEKA) y textos al elegir formato en el carrito.
          Se publican al guardar, sin redeploy.
        </p>

        <h3 class="admin-section-title" style="font-size:1rem; margin:0.25rem 0 0.5rem">Mensaje del álbum</h3>
        <p class="admin-muted" style="margin-top:0">
          Sale en la tienda debajo del título, antes de la grilla. Si una serie no tiene texto propio, usa el general.
        </p>
        <div class="admin-form" data-album-messages>
          <label>
            Texto general (todas las series del portafolio en tienda)
            <textarea
              data-album-msg-default
              rows="2"
              maxlength="500"
              placeholder="Alta resolución. Cuando confirmamos la transferencia por WhatsApp, te la mando por ahí."
            ></textarea>
          </label>
          <div data-album-msg-list></div>
        </div>

        <h3 class="admin-section-title" style="font-size:1rem; margin:1.25rem 0 0.5rem">Formatos del carrito</h3>
        <p class="admin-muted" style="margin-top:0">
          Lo que ve el cliente al elegir “Para redes” / “Para impresión”.
        </p>
        <div class="admin-form" data-formats>
          <label>
            Texto “Para redes”
            <textarea data-fmt-hint="redes" rows="2" maxlength="280" placeholder="Archivo liviano, listo para subir a IG/web."></textarea>
          </label>
          <label>
            Texto “Para impresión”
            <textarea
              data-fmt-hint="impresion"
              rows="2"
              maxlength="280"
              placeholder="Alta resolución para imprimir (hasta el tamaño que indique Sole)."
            ></textarea>
          </label>
        </div>
      </div>

      <div class="admin-card">
        <h2 class="admin-section-title">Sobre mí</h2>
        <form class="admin-form" data-about-form onsubmit="return false">
          <label>
            Título
            <input name="title" maxlength="80" />
          </label>
          <label>
            Texto (un párrafo por línea)
            <textarea name="body" rows="8" maxlength="4000"></textarea>
          </label>
          <div class="admin-grid-2" style="align-items:end">
            <label>
              Foto actual
              <div class="admin-thumb-row">
                <img data-about-preview alt="" width="160" height="200" />
              </div>
            </label>
            <label>
              Cambiar foto
              <input type="file" accept="image/*" data-about-file />
            </label>
          </div>
        </form>
      </div>

      <div class="admin-card">
        <div class="admin-head" style="margin-bottom:0.5rem; padding:0">
          <h2 class="admin-section-title" style="margin:0">Proyectos (Trabajos)</h2>
          <button type="button" class="admin-btn admin-btn--ghost" data-add-project>Agregar proyecto</button>
        </div>
        <p class="admin-muted" style="margin-top:0">
          Cover + galería. Las fotos se suben a Supabase y quedan públicas en la web.
        </p>
        <label style="display:block; margin-bottom:1rem">
          Intro de la página Trabajos
          <input data-trabajos-intro maxlength="200" placeholder="Selección de proyectos y series." />
        </label>
        <div data-projects></div>
      </div>

      <div class="admin-sticky-bar">
        <div>
          <p class="admin-muted" style="margin:0">Cambios visibles en /trabajos, /sobre-mi, tienda (mensajes de álbum), carrito y /proyecto/…</p>
          <p class="admin-msg admin-msg--ok" data-save-status hidden style="margin:0.35rem 0 0"></p>
        </div>
        <button type="button" class="admin-btn" data-save-bottom>Guardar todo</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script define:vars={{ siteSeed: site }}>
  window.__SOLEPH_SITE_SEED__ = siteSeed;
</script>

<script>
  import { requireAdminOrRedirect, slugify } from '../../lib/admin-auth.js';
  import {
    loadPortfolioContent,
    normalizePortfolio,
    normalizeProject,
    portfolioFallbackFromSite,
    uploadPortfolioImage,
    PORTFOLIO_SETTINGS_KEY,
  } from '../../lib/portfolio.js';
  import { getSupabase } from '../../lib/supabase.js';
  import {
    loadStorefrontSettings,
    normalizeFormats,
    normalizeAlbumMessages,
    DEFAULT_FORMATS,
    DEFAULT_ALBUM_MESSAGE,
  } from '../../lib/settings.js';

  const root = document.querySelector('[data-admin-portfolio]');
  const errEl = root?.querySelector('[data-error]');
  const okEl = root?.querySelector('[data-ok]');
  const loadingEl = root?.querySelector('[data-loading]');
  const readyEl = root?.querySelector('[data-ready]');
  const aboutForm = root?.querySelector('[data-about-form]');
  const aboutPreview = root?.querySelector('[data-about-preview]');
  const aboutFile = root?.querySelector('[data-about-file]');
  const projectsEl = root?.querySelector('[data-projects]');
  const introInput = root?.querySelector('[data-trabajos-intro]');
  const fmtRedes = root?.querySelector('[data-fmt-hint="redes"]');
  const fmtImp = root?.querySelector('[data-fmt-hint="impresion"]');
  const albumMsgDefault = root?.querySelector('[data-album-msg-default]');
  const albumMsgList = root?.querySelector('[data-album-msg-list]');
  const saveBtns = [...(root?.querySelectorAll('[data-save], [data-save-bottom]') || [])];

  /** @type {any} */
  let content = null;
  /** @type {any} */
  let storefront = {};
  /** @type {any} */
  let formats = DEFAULT_FORMATS;
  /** @type {{ default: string, by_id: Record<string, string> }} */
  let albumMessages = normalizeAlbumMessages(null, { default: DEFAULT_ALBUM_MESSAGE });
  /** @type {Array<{ id: string, name: string, seedMessage?: string }>} */
  let shopAlbums = [];
  let busy = false;

  function showError(msg) {
    if (!errEl) return;
    errEl.hidden = !msg;
    errEl.textContent = msg || '';
    if (msg) {
      errEl.classList.add('is-flash');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      setTimeout(() => errEl.classList.remove('is-flash'), 1200);
    }
    // mirror near sticky save
    const sticky = root?.querySelector('[data-save-status]');
    if (sticky) {
      sticky.hidden = !msg;
      sticky.textContent = msg || '';
      sticky.className = 'admin-msg admin-msg--error';
    }
  }
  function showOk(msg) {
    if (!okEl) return;
    okEl.hidden = !msg;
    okEl.textContent = msg || '';
    if (msg) {
      okEl.classList.add('is-flash');
      // always bring success into view (save is often from bottom sticky)
      okEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => okEl.classList.remove('is-flash'), 1600);
    }
    const sticky = root?.querySelector('[data-save-status]');
    if (sticky) {
      sticky.hidden = !msg;
      sticky.textContent = msg || '';
      sticky.className = msg ? 'admin-msg admin-msg--ok' : 'admin-msg admin-msg--ok';
      if (!msg) sticky.hidden = true;
    }
  }

  function setSaveBusy(on, label) {
    busy = on;
    saveBtns.forEach((b) => {
      b.disabled = on;
      if (b.hasAttribute('data-save') || b.hasAttribute('data-save-bottom')) {
        if (on) {
          if (!b.dataset.label) b.dataset.label = b.textContent || 'Guardar todo';
          b.textContent = label || 'Guardando…';
        } else if (label) {
          b.textContent = label;
          setTimeout(() => {
            b.textContent = b.dataset.label || 'Guardar todo';
          }, 2200);
        } else {
          b.textContent = b.dataset.label || 'Guardar todo';
        }
      }
    });
  }
  function escapeHtml(s) {
    return String(s)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function fillAbout() {
    if (!aboutForm || !content) return;
    aboutForm.title.value = content.about.title || '';
    aboutForm.body.value = content.about.body || '';
    if (aboutPreview) {
      aboutPreview.src = content.about.image || '/images/sobre-mi.jpg';
    }
    if (introInput) introInput.value = content.trabajos_intro || '';
  }

  function fillFormats() {
    const opts = formats?.options || [];
    const redes = opts.find((o) => o.id === 'redes') || DEFAULT_FORMATS.options[0];
    const imp = opts.find((o) => o.id === 'impresion') || DEFAULT_FORMATS.options[1];
    if (fmtRedes) fmtRedes.value = redes?.hint || '';
    if (fmtImp) fmtImp.value = imp?.hint || '';
  }

  function fillAlbumMessages() {
    if (albumMsgDefault) {
      albumMsgDefault.value = albumMessages?.default || DEFAULT_ALBUM_MESSAGE;
    }
    if (!albumMsgList) return;
    if (!shopAlbums.length) {
      albumMsgList.innerHTML =
        '<p class="admin-muted">No hay series de tienda en el seed. El texto general igual aplica.</p>';
      return;
    }
    albumMsgList.innerHTML = shopAlbums
      .map((a) => {
        const saved = albumMessages?.by_id?.[a.id];
        // si hay override guardado lo mostramos; si no, vacío = usa el general (no re-inyectar seed)
        const value = saved != null ? saved : '';
        return `<label>
          Texto propio · ${escapeHtml(a.name)} <span class="admin-muted">(${escapeHtml(a.id)})</span>
          <textarea data-album-msg-id="${escapeHtml(a.id)}" rows="2" maxlength="500" placeholder="Vacío = usa el texto general">${escapeHtml(value)}</textarea>
        </label>`;
      })
      .join('');
  }

  function readFormatsFromForm() {
    const base = normalizeFormats(formats, DEFAULT_FORMATS);
    const options = base.options.map((o) => {
      if (o.id === 'redes') return { ...o, hint: String(fmtRedes?.value || '').trim() };
      if (o.id === 'impresion') return { ...o, hint: String(fmtImp?.value || '').trim() };
      return o;
    });
    // ensure both exist
    if (!options.some((o) => o.id === 'redes')) {
      options.unshift({
        id: 'redes',
        label: 'Para redes',
        hint: String(fmtRedes?.value || '').trim(),
      });
    }
    if (!options.some((o) => o.id === 'impresion')) {
      options.push({
        id: 'impresion',
        label: 'Para impresión',
        hint: String(fmtImp?.value || '').trim(),
      });
    }
    formats = normalizeFormats({ default: base.default, options }, DEFAULT_FORMATS);
    return formats;
  }

  function readAlbumMessagesFromForm() {
    /** @type {Record<string, string>} */
    const by_id = {};
    albumMsgList?.querySelectorAll('[data-album-msg-id]').forEach((el) => {
      const id = el.getAttribute('data-album-msg-id');
      const msg = String(/** @type {HTMLTextAreaElement} */ (el).value || '').trim();
      if (id && msg) by_id[id] = msg;
    });
    albumMessages = normalizeAlbumMessages(
      {
        default: String(albumMsgDefault?.value || '').trim() || DEFAULT_ALBUM_MESSAGE,
        by_id,
      },
      { default: DEFAULT_ALBUM_MESSAGE },
    );
    return albumMessages;
  }

  function projectCard(p, idx) {
    const images = (p.images || [])
      .map(
        (src, i) => `
      <div class="admin-pf-img" data-img-i="${i}">
        <img src="${escapeHtml(src)}" alt="" loading="lazy" />
        <button type="button" class="admin-btn admin-btn--ghost" data-rm-img data-i="${i}">Quitar</button>
      </div>`,
      )
      .join('');
    return `
    <article class="admin-card admin-pf-project" data-project-idx="${idx}">
      <div class="admin-grid-2">
        <label>Título
          <input data-f="title" value="${escapeHtml(p.title || '')}" maxlength="120" />
        </label>
        <label>Slug (URL)
          <input data-f="slug" value="${escapeHtml(p.slug || '')}" maxlength="80" />
        </label>
        <label>Año
          <input data-f="year" type="number" value="${escapeHtml(String(p.year || ''))}" />
        </label>
        <label>Cover
          <div class="admin-thumb-row">
            <img src="${escapeHtml(p.cover || '')}" alt="" data-cover-img width="120" height="90" />
            <input type="file" accept="image/*" data-cover-file />
          </div>
        </label>
      </div>
      <div class="admin-pf-gallery">
        <div class="admin-pf-gallery-head">
          <strong>Fotos del proyecto</strong>
          <label class="admin-btn admin-btn--ghost" style="margin:0">
            Sumar fotos
            <input type="file" accept="image/*" multiple data-add-imgs class="sr-only" />
          </label>
        </div>
        <div class="admin-pf-imgs" data-imgs>${images || '<p class="admin-muted">Todavía no hay fotos.</p>'}</div>
      </div>
      <div class="admin-actions" style="margin-top:0.75rem">
        <button type="button" class="admin-btn admin-btn--danger" data-rm-project>Borrar proyecto</button>
      </div>
    </article>`;
  }

  function renderProjects() {
    if (!projectsEl || !content) return;
    if (!content.projects.length) {
      projectsEl.innerHTML = '<p class="admin-empty">No hay proyectos. Agregá el primero.</p>';
      return;
    }
    projectsEl.innerHTML = content.projects.map((p, i) => projectCard(p, i)).join('');
    bindProjectCards();
  }

  function readProjectFields(card) {
    const idx = Number(card.getAttribute('data-project-idx'));
    const p = content.projects[idx];
    if (!p) return;
    const title = card.querySelector('[data-f="title"]')?.value?.trim() || '';
    let slug = card.querySelector('[data-f="slug"]')?.value?.trim() || '';
    if (!slug && title) slug = slugify(title);
    p.title = title;
    p.slug = slugify(slug || title);
    p.year = Number(card.querySelector('[data-f="year"]')?.value) || new Date().getFullYear();
    p.href = `/proyecto/${p.slug}`;
  }

  function syncAllFields() {
    if (!content) return;
    if (aboutForm) {
      content.about.title = aboutForm.title.value.trim() || 'Sobre mí';
      content.about.body = aboutForm.body.value.trim();
    }
    if (introInput) content.trabajos_intro = introInput.value.trim();
    projectsEl?.querySelectorAll('[data-project-idx]').forEach((card) => readProjectFields(card));
  }

  function bindProjectCards() {
    projectsEl?.querySelectorAll('[data-project-idx]').forEach((card) => {
      const idx = Number(card.getAttribute('data-project-idx'));
      card.querySelector('[data-cover-file]')?.addEventListener('change', async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        try {
          showError('');
          const url = await uploadPortfolioImage(file, content.projects[idx]?.slug || 'cover');
          content.projects[idx].cover = url;
          if (!content.projects[idx].images?.length) content.projects[idx].images = [url];
          const img = card.querySelector('[data-cover-img]');
          if (img) img.src = url;
          showOk('Cover subido');
        } catch (err) {
          showError(err?.message || 'No se pudo subir el cover');
        }
      });
      card.querySelector('[data-add-imgs]')?.addEventListener('change', async (e) => {
        const files = [...(e.target.files || [])];
        if (!files.length) return;
        try {
          showError('');
          const slug = content.projects[idx]?.slug || 'proj';
          for (const f of files) {
            const url = await uploadPortfolioImage(f, slug);
            content.projects[idx].images = content.projects[idx].images || [];
            content.projects[idx].images.push(url);
            if (!content.projects[idx].cover) content.projects[idx].cover = url;
          }
          e.target.value = '';
          renderProjects();
          showOk(`${files.length} foto(s) sumadas`);
        } catch (err) {
          showError(err?.message || 'No se pudieron subir las fotos');
        }
      });
      card.querySelectorAll('[data-rm-img]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const i = Number(btn.getAttribute('data-i'));
          content.projects[idx].images.splice(i, 1);
          renderProjects();
        });
      });
      card.querySelector('[data-rm-project]')?.addEventListener('click', () => {
        if (!confirm('¿Borrar este proyecto del portafolio?')) return;
        content.projects.splice(idx, 1);
        renderProjects();
      });
    });
  }

  aboutFile?.addEventListener('change', async () => {
    const file = aboutFile.files?.[0];
    if (!file) return;
    try {
      showError('');
      const url = await uploadPortfolioImage(file, 'about');
      content.about.image = url;
      if (aboutPreview) aboutPreview.src = url;
      showOk('Foto de Sobre mí subida');
    } catch (err) {
      showError(err?.message || 'No se pudo subir la foto');
    }
  });

  root?.querySelector('[data-add-project]')?.addEventListener('click', () => {
    syncAllFields();
    content.projects.push(
      normalizeProject({
        slug: `serie-${content.projects.length + 1}`,
        title: 'Nueva serie',
        year: new Date().getFullYear(),
        cover: '/images/logo.png',
        images: [],
      }),
    );
    renderProjects();
  });

  async function save() {
    if (busy) return;
    if (!content) {
      showError('Todavía está cargando. Esperá un segundo y volvé a tocar Guardar.');
      return;
    }
    showError('');
    showOk('');
    syncAllFields();
    const payload = normalizePortfolio(content, content);
    // Sobre mí: si quedó vacío, no bloqueamos formatos/proyectos — usamos el seed
    if (!payload.about.body.trim()) {
      const seedBody = String(window.__SOLEPH_SITE_SEED__?.about?.body || '').trim();
      if (seedBody) payload.about.body = seedBody;
    }
    if (!payload.about.body.trim()) {
      showError('Completá el texto de Sobre mí antes de guardar.');
      return;
    }
    for (const p of payload.projects) {
      if (!p.title || !p.slug) {
        showError('Cada proyecto necesita título y slug');
        return;
      }
    }
    const formatsPayload = readFormatsFromForm();
    const albumMsgPayload = readAlbumMessagesFromForm();
    setSaveBusy(true, 'Guardando…');
    try {
      const sb = getSupabase();
      const now = new Date().toISOString();
      const { data: pfRow, error } = await sb
        .from('settings')
        .upsert(
          {
            key: PORTFOLIO_SETTINGS_KEY,
            value: payload,
            updated_at: now,
          },
          { onConflict: 'key' },
        )
        .select('key, updated_at')
        .single();
      if (error) throw error;
      if (!pfRow?.key) throw new Error('No se confirmó el guardado del portafolio');

      // merge formats + album messages into storefront (keep transfer etc.)
      const nextStore = {
        ...(storefront && typeof storefront === 'object' ? storefront : {}),
        formats: formatsPayload,
        album_messages: albumMsgPayload,
      };
      const { data: stRow, error: sErr } = await sb
        .from('settings')
        .upsert(
          {
            key: 'storefront',
            value: nextStore,
            updated_at: now,
          },
          { onConflict: 'key' },
        )
        .select('key, updated_at')
        .single();
      if (sErr) throw sErr;
      if (!stRow?.key) throw new Error('No se confirmó el guardado de textos de tienda');

      storefront = nextStore;
      formats = formatsPayload;
      albumMessages = albumMsgPayload;
      content = payload;
      fillAbout();
      fillFormats();
      fillAlbumMessages();
      renderProjects();
      const when = new Date().toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      showOk(`✓ Guardado a las ${when}. Ya está en la web (hard refresh si no lo ves).`);
      setSaveBusy(false, '✓ Guardado');
    } catch (err) {
      console.error('portfolio save', err);
      showError(err?.message || 'No se pudo guardar');
      setSaveBusy(false);
    }
  }

  saveBtns.forEach((b) => b.addEventListener('click', save));

  async function load() {
    const gate = await requireAdminOrRedirect();
    if (!gate) return;
    try {
      const seedSite = window.__SOLEPH_SITE_SEED__ || {};
      const seed = portfolioFallbackFromSite(seedSite);
      content = await loadPortfolioContent(seed);
      shopAlbums = (seedSite.shop?.albums || [])
        .filter((a) => a && a.id)
        .map((a) => ({
          id: String(a.id),
          name: String(a.name || a.id),
          seedMessage: String(a.message || '').trim() || undefined,
        }));
      // seed album messages: solo default; overrides por serie se cargan de SB si existen
      const store = await loadStorefrontSettings({
        formats: seedSite.shop?.formats,
        transfer: seedSite.shop?.transfer,
        album_messages: {
          default:
            shopAlbums.find((a) => a.seedMessage)?.seedMessage || DEFAULT_ALBUM_MESSAGE,
          by_id: {},
        },
      });
      formats = store.formats;
      albumMessages = store.album_messages;
      storefront = store.raw || {
        transfer: store.transfer,
        formats: store.formats,
        album_messages: store.album_messages,
      };
      fillAbout();
      fillFormats();
      fillAlbumMessages();
      renderProjects();
      loadingEl && (loadingEl.hidden = true);
      readyEl && (readyEl.hidden = false);
    } catch (err) {
      loadingEl && (loadingEl.hidden = true);
      showError(err?.message || 'No se pudo cargar el portafolio');
    }
  }

  load();
</script>
