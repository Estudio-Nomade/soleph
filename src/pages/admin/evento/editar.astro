---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Editar evento">
  <div data-admin-edit>
    <div class="admin-head">
      <div>
        <h1 data-title>Evento</h1>
        <p data-sub>Completá datos, armá carpetas por categoría y subí todo de una.</p>
      </div>
      <div class="admin-actions">
        <a class="admin-btn admin-btn--ghost" href="/admin">Volver</a>
        <button type="button" class="admin-btn" data-publish-event disabled>Subir evento</button>
      </div>
    </div>

    <p class="admin-msg admin-msg--error" data-error hidden></p>
    <p class="admin-msg admin-msg--ok" data-ok hidden></p>
    <p class="admin-msg admin-msg--info" data-loading>Cargando…</p>
    <p class="admin-msg admin-msg--info" data-queue-status hidden></p>

    <div class="admin-upload-banner" data-upload-banner hidden role="status" aria-live="polite">
      <div class="admin-upload-banner-inner">
        <span class="admin-upload-banner-spin" aria-hidden="true"></span>
        <div class="admin-upload-banner-text">
          <strong data-upload-banner-title>Subiendo… no cierres ni salgas de esta página</strong>
          <span data-upload-banner-detail></span>
        </div>
      </div>
    </div>

    <div data-ready hidden>
      <div class="admin-card">
        <h2 class="admin-section-title">1. Datos del evento</h2>
        <form class="admin-form" data-form-meta>
          <label>
            Nombre
            <input name="name" required maxlength="120" />
          </label>
          <div class="admin-grid-2">
            <label>
              Slug
              <input name="slug" required maxlength="80" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" />
            </label>
            <label>
              Fecha (texto)
              <input name="date_label" maxlength="80" />
            </label>
          </div>
          <label>
            Tipo
            <select name="kind">
              <option value="event">Evento</option>
              <option value="portfolio">Portafolio</option>
            </select>
          </label>
          <label>
            Mensaje al comprador
            <textarea name="message" maxlength="500"></textarea>
          </label>
          <p class="admin-muted" style="margin:0">
            Cada foto se indexa para <strong>Buscar mis fotos</strong> al subir (automático).
          </p>
          <input type="hidden" name="search_by_face" value="on" />
          <p class="admin-muted" data-publish-note style="margin:0">
            Al tocar <strong>Subir evento</strong> el álbum queda publicado en la tienda.
          </p>
          <input type="hidden" name="published" value="on" />
        </form>
      </div>

      <div class="admin-card">
        <h2 class="admin-section-title">2. Precios y packs</h2>
        <p class="admin-muted" style="margin-top:0">
          El precio de <strong>1 foto</strong> es el que sale en el panel y en la tienda.
          Los packs son precio total del combo. Guardá acá o con <strong>Subir evento</strong>.
        </p>
        <label style="display:block; margin-bottom:0.85rem; max-width:16rem">
          Precio 1 foto (ARS)
          <input data-unit-price type="number" min="0" step="100" required />
        </label>
        <div class="admin-tiers" data-tiers></div>
        <div class="admin-actions" style="margin-top:0.75rem">
          <button type="button" class="admin-btn admin-btn--ghost" data-add-tier>Agregar pack</button>
          <button type="button" class="admin-btn" data-save-prices>Guardar cambios</button>
        </div>
      </div>

      <div class="admin-card">
        <h2 class="admin-section-title">3. Categorías</h2>
        <p class="admin-muted" style="margin-top:0">
          Ej: Mansos, Potros, Damas. Después subís una carpeta o fotos directo a cada una.
        </p>
        <div class="admin-cat-list" data-cat-list></div>
        <div class="admin-actions" style="margin-top:0.75rem; align-items:end">
          <label style="flex:1; min-width:12rem">
            Nueva categoría
            <input type="text" data-cat-name maxlength="40" placeholder="Ej. Mansos" />
          </label>
          <button type="button" class="admin-btn" data-cat-add>Agregar</button>
          <button type="button" class="admin-btn admin-btn--ghost" data-cat-seed>Mansos · Potros · Damas</button>
        </div>
      </div>

      <div class="admin-card">
        <h2 class="admin-section-title">4. Fotos por categoría</h2>
        <p class="admin-muted" style="margin-top:0">
          Elegí <strong>carpeta</strong> o <strong>fotos</strong> en cada categoría. Quedan en cola
          hasta que toques <strong>Subir evento</strong> (guarda datos, sube archivos e indexa caras).
        </p>
        <p class="admin-muted" style="margin-top:0.35rem">
          <strong>Peso máximo: 50&nbsp;MB por foto</strong> al leerlas de tu compu (JPG o PNG). Si alguna
          pesa más, exportala más liviana antes. Con muchas fotos grandes conviene ir de a tandas.
        </p>
        <p class="admin-muted" style="margin-top:0.35rem">
          <strong>Modo vitrina:</strong> a la web solo sube un JPEG comprimido con marca de agua
          (~1024px, para mirar y elegir). <strong>No se guarda el original de cámara</strong> —
          ese lo mandás vos al cliente por fuera cuando confirma el pago.
        </p>

        <div class="admin-upload-cats" data-upload-cats></div>

        <div class="admin-queue" data-queue hidden>
          <div class="admin-queue-head">
            <strong data-queue-title>Cola de subida</strong>
            <button type="button" class="admin-btn admin-btn--ghost" data-queue-clear>Vaciar cola</button>
          </div>
          <ul class="admin-queue-list" data-queue-list></ul>
        </div>

        <p class="admin-progress" data-upload-status hidden></p>
      </div>

      <div class="admin-card">
        <h2 class="admin-section-title">Fotos ya en el evento</h2>
        <p class="admin-muted" style="margin-top:0">
          Cover, marcar varias y borrar. Si hace falta, podés cambiar la categoría de una foto suelta.
        </p>
        <div class="admin-tools" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin:0.75rem 0 0.5rem">
          <button type="button" class="admin-btn admin-btn--ghost" data-reapply-wm>
            Actualizar marcas de agua
          </button>
        </div>
        <p class="admin-muted" style="margin-top:0">
          Vuelve a marcar los previews con <strong>un solo logo</strong> (solo fotos viejas que
          todavía tienen original en la nube). Los eventos nuevos en modo vitrina no guardan original.
        </p>
        <div class="admin-photo-select-bar" data-photo-select-bar hidden>
          <span data-photo-select-count>0 seleccionadas</span>
          <div class="admin-photo-select-actions">
            <button type="button" class="admin-btn admin-btn--ghost" data-photo-select-all>
              Seleccionar todas
            </button>
            <button type="button" class="admin-btn admin-btn--ghost" data-photo-select-none>
              Ninguna
            </button>
            <button type="button" class="admin-btn admin-btn--danger" data-photo-delete-selected>
              Borrar seleccionadas
            </button>
          </div>
          <p class="admin-progress" data-photo-bulk-status hidden style="margin:0;width:100%"></p>
        </div>
        <div class="admin-photos" data-photos style="margin-top:0.5rem"></div>
        <p class="admin-empty" data-photos-empty hidden>Todavía no hay fotos subidas.</p>
      </div>

      <div class="admin-card">
        <h2 class="admin-section-title">Zona de riesgo</h2>
        <p class="admin-muted" style="margin-top:0" data-delete-hint>
          Borra el álbum de la base y de la tienda (fotos incluidas). No se puede deshacer.
        </p>
        <button type="button" class="admin-btn admin-btn--danger" data-delete-album>Borrar álbum</button>
      </div>

      <div class="admin-sticky-bar">
        <p class="admin-muted" data-sticky-hint style="margin:0">
          La cola y los datos se confirman con un solo botón.
        </p>
        <button type="button" class="admin-btn" data-publish-event-bottom disabled>Subir evento</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { requireAdminOrRedirect, formatArs } from '../../../lib/admin-auth.js';
  import { getSupabase, publicStorageUrl, BUCKETS } from '../../../lib/supabase.js';
  import {
    fetchAlbumPhotos,
    fetchPhotoCategoryLinks,
    linksToPhotoCatMap,
  } from '../../../lib/supabase-page.js';
  import { makeWatermarkedPreview, safeFileBase } from '../../../lib/watermark.js';
  import { indexPhotoFacesWithRetry, photoHasIndexedFaces } from '../../../lib/face.js';
  import { formatStorageError, uploadWithRetry, removeStoragePaths } from '../../../lib/storage-upload.js';
  import { deleteStorageObjects, presignStorage } from '../../../lib/storage-api.js';
  import {
    cameraCodeFromFilename,
    slugifyCategory,
    DEFAULT_CATEGORY_NAMES,
  } from '../../../lib/photo-meta.js';

  const root = document.querySelector('[data-admin-edit]');
  const albumId = new URLSearchParams(window.location.search).get('id');
  const errEl = root?.querySelector('[data-error]');
  const okEl = root?.querySelector('[data-ok]');
  const loadingEl = root?.querySelector('[data-loading]');
  const readyEl = root?.querySelector('[data-ready]');
  const titleEl = root?.querySelector('[data-title]');
  const subEl = root?.querySelector('[data-sub]');
  const form = root?.querySelector('[data-form-meta]');
  const unitPriceInput = root?.querySelector('[data-unit-price]');
  const tiersEl = root?.querySelector('[data-tiers]');
  const photosEl = root?.querySelector('[data-photos]');
  const photosEmpty = root?.querySelector('[data-photos-empty]');
  const uploadStatus = root?.querySelector('[data-upload-status]');
  const uploadBanner = root?.querySelector('[data-upload-banner]');
  const uploadBannerTitle = root?.querySelector('[data-upload-banner-title]');
  const uploadBannerDetail = root?.querySelector('[data-upload-banner-detail]');
  const queueStatus = root?.querySelector('[data-queue-status]');
  const catListEl = root?.querySelector('[data-cat-list]');
  const catNameInput = root?.querySelector('[data-cat-name]');
  const uploadCatsEl = root?.querySelector('[data-upload-cats]');
  const queueWrap = root?.querySelector('[data-queue]');
  const queueList = root?.querySelector('[data-queue-list]');
  const queueTitle = root?.querySelector('[data-queue-title]');
  const stickyHint = root?.querySelector('[data-sticky-hint]');
  const photoSelectBar = root?.querySelector('[data-photo-select-bar]');
  const photoSelectCount = root?.querySelector('[data-photo-select-count]');
  const photoBulkStatus = root?.querySelector('[data-photo-bulk-status]');
  const publishBtns = [...(root?.querySelectorAll('[data-publish-event], [data-publish-event-bottom]') || [])];

  /** @type {any} */
  let album = null;
  /** @type {any[]} */
  let photos = [];
  /** @type {any[]} */
  let categories = [];
  /** @type {Record<string, string[]>} */
  let photoCatMap = {};
  /** @type {Set<string>} */
  let selectedPhotoIds = new Set();
  /**
   * Pending uploads before "Subir evento"
   * @type {{ id: string, file: File, categoryId: string, categoryName: string }[]}
   */
  let queue = [];
  /** Límite al encolar desde la compu (el preview vitrina sale mucho más chico). */
  const ORIG_MAX_BYTES = 50 * 1024 * 1024;
  const ORIG_MAX_MB = 50;
  /** Producto: tienda = vitrina. No subir JPG de cámara a album-originals. */
  const STOREFRONT_PREVIEWS_ONLY = true;
  let busy = false;
  let beforeUnloadBound = false;

  function onBeforeUnload(e) {
    e.preventDefault();
    e.returnValue = '';
  }

  function bindBeforeUnload(on) {
    if (on && !beforeUnloadBound) {
      window.addEventListener('beforeunload', onBeforeUnload);
      beforeUnloadBound = true;
    } else if (!on && beforeUnloadBound) {
      window.removeEventListener('beforeunload', onBeforeUnload);
      beforeUnloadBound = false;
    }
  }

  /**
   * @param {{ on?: boolean, title?: string, detail?: string }} opts
   */
  function setUploadBanner({ on, title, detail } = {}) {
    if (!uploadBanner) return;
    if (typeof on === 'boolean') uploadBanner.hidden = !on;
    if (title != null && uploadBannerTitle) uploadBannerTitle.textContent = title;
    if (detail != null && uploadBannerDetail) uploadBannerDetail.textContent = detail;
  }

  /** Espeja progreso en el p de §4 y en el banner fijo. */
  function setProgress(msg) {
    const text = msg || '';
    if (uploadStatus) {
      uploadStatus.hidden = !text;
      uploadStatus.textContent = text;
    }
    if (text) {
      setUploadBanner({
        on: true,
        title: 'Subiendo… no cierres ni salgas de esta página',
        detail: text,
      });
      if (stickyHint) stickyHint.textContent = text;
    }
  }

  function clearProgressSoon() {
    setTimeout(() => {
      if (busy) return;
      if (uploadStatus) uploadStatus.hidden = true;
      setUploadBanner({ on: false, detail: '' });
      if (stickyHint) {
        stickyHint.textContent = queue.length
          ? `${queue.length} en cola · listo para subir`
          : 'La cola y los datos se confirman con un solo botón.';
      }
    }, 2500);
  }

  function escapeHtml(s) {
    return String(s)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function showError(msg) {
    if (!errEl) return;
    errEl.hidden = !msg;
    errEl.textContent = msg || '';
    if (msg) window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showOk(msg) {
    if (!okEl) return;
    okEl.hidden = !msg;
    okEl.textContent = msg || '';
  }

  function setBusy(on) {
    busy = on;
    publishBtns.forEach((b) => {
      b.disabled = on || !albumId;
    });
    document.body.classList.toggle('admin-uploading', on);
    bindBeforeUnload(on);
    if (on) {
      setUploadBanner({
        on: true,
        title: 'Subiendo… no cierres ni salgas de esta página',
        detail: '',
      });
    } else {
      setUploadBanner({ on: false });
    }
  }

  function syncPublishEnabled() {
    publishBtns.forEach((b) => {
      b.disabled = busy || !albumId;
    });
  }

  function fileKey(file) {
    return `${file.webkitRelativePath || file.name}::${file.size}::${file.lastModified}`;
  }

  function isImageFile(file) {
    return (
      file.type.startsWith('image/') ||
      /\.(jpe?g|png|webp|heic|heif|cr2|nef|arw)$/i.test(file.name)
    );
  }

  function categoryLabel(categoryId) {
    if (!categoryId) return 'Sin categoría';
    return categories.find((c) => c.id === categoryId)?.name || 'Categoría';
  }

  function renderQueue() {
    const n = queue.length;
    if (queueWrap) queueWrap.hidden = n === 0;
    if (queueTitle) queueTitle.textContent = n ? `Cola de subida · ${n} archivo(s)` : 'Cola de subida';
    if (stickyHint) {
      stickyHint.textContent = n
        ? `${n} foto(s) en cola · se suben al tocar “Subir evento”`
        : 'La cola y los datos se confirman con un solo botón.';
    }
    if (queueStatus) {
      if (n) {
        queueStatus.hidden = false;
        queueStatus.textContent = `${n} foto(s) listas en cola. Todavía no se subieron.`;
      } else {
        queueStatus.hidden = true;
        queueStatus.textContent = '';
      }
    }
    if (!queueList) return;
    if (!n) {
      queueList.innerHTML = '';
      return;
    }
    // group by category
    /** @type {Record<string, typeof queue>} */
    const groups = {};
    for (const item of queue) {
      const k = item.categoryId || '';
      if (!groups[k]) groups[k] = [];
      groups[k].push(item);
    }
    queueList.innerHTML = Object.entries(groups)
      .map(([catId, items]) => {
        const title = escapeHtml(categoryLabel(catId));
        const rows = items
          .slice(0, 40)
          .map((it) => {
            const label = escapeHtml(it.file.webkitRelativePath || it.file.name);
            return `<li class="admin-queue-item">
              <span title="${label}">${label}</span>
              <button type="button" class="admin-btn admin-btn--ghost" data-queue-rm="${it.id}">Quitar</button>
            </li>`;
          })
          .join('');
        const more =
          items.length > 40
            ? `<li class="admin-queue-more">… y ${items.length - 40} más</li>`
            : '';
        return `<li class="admin-queue-group">
          <div class="admin-queue-group-title">${title} · ${items.length}</div>
          <ul>${rows}${more}</ul>
        </li>`;
      })
      .join('');

    queueList.querySelectorAll('[data-queue-rm]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-queue-rm');
        queue = queue.filter((q) => q.id !== id);
        renderQueue();
      });
    });
  }

  function enqueueFiles(fileList, categoryId) {
    const files = [...fileList]
      .filter(isImageFile)
      .sort((a, b) =>
        String(a.webkitRelativePath || a.name).localeCompare(String(b.webkitRelativePath || b.name)),
      );
    if (!files.length) {
      showError('No encontramos imágenes en lo que elegiste');
      return;
    }
    const existing = new Set(queue.map((q) => fileKey(q.file)));
    let added = 0;
    /** @type {string[]} */
    const tooHeavy = [];
    const catName = categoryLabel(categoryId);
    for (const file of files) {
      const key = fileKey(file);
      if (existing.has(key)) continue;
      if (typeof file.size === 'number' && file.size > ORIG_MAX_BYTES) {
        const mb = (file.size / (1024 * 1024)).toFixed(1);
        tooHeavy.push(`${file.name} (${mb} MB)`);
        continue;
      }
      existing.add(key);
      queue.push({
        id: `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`,
        file,
        categoryId: categoryId || '',
        categoryName: catName,
      });
      added += 1;
    }
    if (tooHeavy.length) {
      const sample = tooHeavy.slice(0, 3).join(', ');
      const extra = tooHeavy.length > 3 ? ` y ${tooHeavy.length - 3} más` : '';
      showError(
        `${tooHeavy.length} foto(s) superan ${ORIG_MAX_MB} MB y no entraron a la cola: ${sample}${extra}. Exportalas más livianas e intentá de nuevo.`,
      );
    } else {
      showError('');
    }
    if (added) {
      showOk(
        `Sumamos ${added} a la cola${categoryId ? ` · ${catName}` : ''}. Tocá “Subir evento” para mandarlas.`,
      );
    } else if (!tooHeavy.length) {
      showOk('Esas fotos ya estaban en la cola');
    }
    renderQueue();
  }

  function clearQueue() {
    if (!queue.length) return;
    if (!confirm(`¿Vaciar la cola (${queue.length} archivo(s))?`)) return;
    queue = [];
    renderQueue();
    showOk('Cola vacía');
  }

  function renderCategories() {
    if (catListEl) {
      if (!categories.length) {
        catListEl.innerHTML = '<p class="admin-muted">Todavía no hay categorías. Agregá al menos una para ordenar la subida.</p>';
      } else {
        catListEl.innerHTML = categories
          .map(
            (c) => `<div class="admin-cat-row">
              <span>${escapeHtml(c.name)}</span>
              <button type="button" class="admin-btn admin-btn--ghost" data-cat-del="${c.id}">Quitar</button>
            </div>`,
          )
          .join('');
        catListEl.querySelectorAll('[data-cat-del]').forEach((btn) => {
          btn.addEventListener('click', () => deleteCategory(btn.getAttribute('data-cat-del')));
        });
      }
    }
    renderUploadZones();
  }

  function renderUploadZones() {
    if (!uploadCatsEl) return;
    const zones = [
      ...categories.map((c) => ({ id: c.id, name: c.name })),
      { id: '', name: 'Sin categoría' },
    ];
    uploadCatsEl.innerHTML = zones
      .map((z) => {
        const pending = queue.filter((q) => q.categoryId === (z.id || '')).length;
        const badge = pending ? `<span class="admin-queue-badge">${pending} en cola</span>` : '';
        const catAttr = z.id ? `data-cat-id="${z.id}"` : 'data-cat-id=""';
        return `<div class="admin-upload-cat" ${catAttr}>
          <div class="admin-upload-cat-head">
            <strong>${escapeHtml(z.name)}</strong>
            ${badge}
          </div>
          <div class="admin-actions" style="justify-content:flex-start; margin-top:0.55rem">
            <label class="admin-btn admin-btn--ghost" style="cursor:pointer">
              Carpeta
              <input type="file" accept="image/*" multiple webkitdirectory directory data-folder />
            </label>
            <label class="admin-btn admin-btn--ghost" style="cursor:pointer">
              Fotos
              <input type="file" accept="image/*" multiple data-files />
            </label>
          </div>
          <p class="admin-inline-note" style="margin-top:0.45rem">
            La carpeta entera (ej. DCIM) entra a <strong>${escapeHtml(z.name)}</strong>.
          </p>
        </div>`;
      })
      .join('');

    uploadCatsEl.querySelectorAll('.admin-upload-cat').forEach((zone) => {
      const catId = zone.getAttribute('data-cat-id') || '';
      const folder = zone.querySelector('[data-folder]');
      const files = zone.querySelector('[data-files]');
      folder?.addEventListener('change', () => {
        if (folder.files?.length) enqueueFiles(folder.files, catId);
        folder.value = '';
      });
      files?.addEventListener('change', () => {
        if (files.files?.length) enqueueFiles(files.files, catId);
        files.value = '';
      });
    });
  }

  async function loadCategories() {
    const sb = getSupabase();
    const { data, error } = await sb
      .from('categories')
      .select('*')
      .eq('album_id', albumId)
      .order('sort_order', { ascending: true });
    if (error) {
      console.warn('categories', error.message);
      categories = [];
    } else {
      categories = data || [];
    }
    renderCategories();
  }

  async function loadPhotoCategories() {
    photoCatMap = {};
    if (!photos.length) return;
    const sb = getSupabase();
    try {
      const links = await fetchPhotoCategoryLinks(sb, {
        categoryIds: categories.map((c) => c.id).filter(Boolean),
        photoIds: photos.map((p) => p.id),
      });
      photoCatMap = linksToPhotoCatMap(links);
    } catch (err) {
      console.warn('photo_categories', err?.message || err);
      showError(err?.message || 'No se pudieron cargar las categorías de las fotos');
    }
  }

  async function addCategory(name) {
    const n = String(name || '').trim();
    if (!n) return;
    showError('');
    try {
      const sb = getSupabase();
      const { data, error } = await sb
        .from('categories')
        .insert({
          album_id: albumId,
          name: n,
          slug: slugifyCategory(n),
          sort_order: categories.length,
        })
        .select('*')
        .single();
      if (error) throw error;
      categories.push(data);
      renderCategories();
      if (catNameInput) catNameInput.value = '';
      showOk(`Categoría “${n}” agregada`);
    } catch (err) {
      showError(err?.message || 'No se pudo agregar la categoría (¿corriste categories.sql?)');
    }
  }

  async function deleteCategory(id) {
    if (!id || !confirm('¿Borrar esta categoría?')) return;
    try {
      const sb = getSupabase();
      const { error } = await sb.from('categories').delete().eq('id', id);
      if (error) throw error;
      categories = categories.filter((c) => c.id !== id);
      // keep queued files but relabel
      queue = queue.map((q) =>
        q.categoryId === id ? { ...q, categoryId: '', categoryName: 'Sin categoría' } : q,
      );
      renderCategories();
      renderQueue();
      showOk('Categoría borrada');
    } catch (err) {
      showError(err?.message || 'No se pudo borrar');
    }
  }

  async function seedDefaultCategories() {
    for (const name of DEFAULT_CATEGORY_NAMES) {
      if (categories.some((c) => c.name.toLowerCase() === name.toLowerCase())) continue;
      await addCategory(name);
    }
  }

  async function setPhotoCategory(photoId, categoryId) {
    const sb = getSupabase();
    const { error: delErr } = await sb.from('photo_categories').delete().eq('photo_id', photoId);
    if (delErr) throw delErr;
    if (categoryId) {
      const { error } = await sb.from('photo_categories').insert({ photo_id: photoId, category_id: categoryId });
      if (error) throw error;
      photoCatMap[photoId] = [categoryId];
    } else {
      photoCatMap[photoId] = [];
    }
  }

  function uniqueCameraCode(desired, used) {
    let code = (desired || '').toUpperCase() || 'FOTO';
    if (!used.has(code)) {
      used.add(code);
      return code;
    }
    let i = 2;
    while (used.has(`${code}-${i}`) && i < 9999) i += 1;
    const next = `${code}-${i}`;
    used.add(next);
    return next;
  }

  function readUnitPrice() {
    const raw = unitPriceInput?.value ?? form?.photo_price_ars?.value ?? album?.photo_price_ars ?? 0;
    const n = Number(raw);
    return Number.isFinite(n) && n >= 0 ? n : 0;
  }

  /**
   * Keep photo_price_ars aligned with pack qty=1 (or create it).
   * Admin list + storefront read photo_price_ars.
   */
  function syncTiersWithUnit(unit, tiers) {
    const u = Math.max(0, Number(unit) || 0);
    let list = Array.isArray(tiers) ? tiers.map((t) => ({ ...t })) : [];
    const one = list.find((t) => Number(t.quantity) === 1);
    if (one) one.price = u;
    else list.unshift({ quantity: 1, price: u });
    list = list
      .filter((t) => Number(t.quantity) >= 1 && Number(t.price) >= 0)
      .sort((a, b) => a.quantity - b.quantity);
    return list;
  }

  function defaultTiers(unit = 5000) {
    const u = Math.max(0, Number(unit) || 5000);
    return [
      { quantity: 1, price: u },
      { quantity: 3, price: Math.round(u * 2.5) },
      { quantity: 5, price: Math.round(u * 4) },
      { quantity: 10, price: Math.round(u * 7) },
    ];
  }

  function tierRow(qty = 3, price = 10000) {
    const row = document.createElement('div');
    row.className = 'admin-tier-row';
    row.innerHTML = `
      <label>Cantidad
        <input type="number" min="1" step="1" name="qty" value="${qty}" />
      </label>
      <label>Precio total pack (ARS)
        <input type="number" min="0" step="100" name="price" value="${price}" />
      </label>
      <button type="button" class="admin-btn admin-btn--ghost" data-remove-tier>Quitar</button>
    `;
    row.querySelector('[data-remove-tier]')?.addEventListener('click', () => row.remove());
    return row;
  }

  function readTiers() {
    if (!tiersEl) return [];
    return [...tiersEl.querySelectorAll('.admin-tier-row')]
      .map((row) => {
        const quantity = Number(row.querySelector('[name="qty"]')?.value || 0);
        const price = Number(row.querySelector('[name="price"]')?.value || 0);
        return { quantity, price };
      })
      .filter((t) => t.quantity >= 1 && t.price >= 0)
      .sort((a, b) => a.quantity - b.quantity);
  }

  function renderTier(list) {
    if (!tiersEl) return;
    tiersEl.innerHTML = '';
    const tiers = Array.isArray(list) && list.length ? list : defaultTiers(album?.photo_price_ars);
    tiers.forEach((t) => tiersEl.appendChild(tierRow(t.quantity, t.price)));
  }

  function fillForm() {
    if (!form || !album) return;
    form.name.value = album.name || '';
    form.slug.value = album.slug || '';
    form.date_label.value = album.date_label || '';
    form.kind.value = album.kind === 'portfolio' ? 'portfolio' : 'event';
    form.message.value = album.message || '';
    // search_by_face always on for events (hidden input)
    if (unitPriceInput) unitPriceInput.value = album.photo_price_ars ?? 5000;
    const isPortfolio = album.kind === 'portfolio';
    if (titleEl) titleEl.textContent = album.name || (isPortfolio ? 'Portafolio' : 'Evento');
    if (subEl) {
      const q = queue.length ? ` · ${queue.length} en cola` : '';
      const tipo = isPortfolio ? 'Portafolio' : 'Evento';
      subEl.textContent = album.published
        ? `${tipo} · Publicado · ${formatArs(album.photo_price_ars)} c/u${q}`
        : `${tipo} · Borrador · ${formatArs(album.photo_price_ars)} c/u · Subir evento lo publica${q}`;
    }
    const delBtn = root?.querySelector('[data-delete-album]');
    if (delBtn && !delBtn.disabled) {
      delBtn.textContent = isPortfolio ? 'Borrar álbum de portafolio' : 'Borrar evento';
    }
    if (tiersEl) {
      renderTier(Array.isArray(album.price_tiers) ? album.price_tiers : []);
    }
  }

  function photoGroupsForAdmin() {
    /** @type {{ id: string, name: string, photos: any[] }[]} */
    const groups = categories.map((c) => ({
      id: c.id,
      name: c.name,
      photos: photos.filter((p) => (photoCatMap[p.id] || []).includes(c.id)),
    }));
    const assigned = new Set(groups.flatMap((g) => g.photos.map((p) => p.id)));
    const uncategorized = photos.filter((p) => !assigned.has(p.id));
    if (uncategorized.length) {
      groups.push({
        id: '',
        name: categories.length ? 'Sin categoría' : 'Todas',
        photos: uncategorized,
      });
    }
    return groups.filter((g) => g.photos.length > 0);
  }

  function photoLabel(photo) {
    return (
      photo?.code ||
      cameraCodeFromFilename(photo?.source_filename || '') ||
      (photo?.id || '').replace(/-/g, '').slice(0, 8).toUpperCase()
    );
  }

  function syncPhotoSelectBar() {
    const n = selectedPhotoIds.size;
    if (photoSelectBar) photoSelectBar.hidden = n === 0;
    if (photoSelectCount) {
      photoSelectCount.textContent =
        n === 0 ? 'Ninguna seleccionada' : n === 1 ? '1 seleccionada' : `${n} seleccionadas`;
    }
    const delBtn = root?.querySelector('[data-photo-delete-selected]');
    if (delBtn) delBtn.disabled = busy || n === 0;
    const allBtn = root?.querySelector('[data-photo-select-all]');
    const noneBtn = root?.querySelector('[data-photo-select-none]');
    if (allBtn) allBtn.disabled = busy || !photos.length;
    if (noneBtn) noneBtn.disabled = busy || n === 0;
  }

  function setPhotoSelected(id, on) {
    if (on) selectedPhotoIds.add(id);
    else selectedPhotoIds.delete(id);
    syncPhotoSelectBar();
  }

  function makeAdminPhotoTile(p) {
    const cover = album?.cover_path || '';
    const url = publicStorageUrl(BUCKETS.previews, p.preview_path);
    const isCover = cover && (cover === p.preview_path || cover.endsWith(p.preview_path));
    const code = photoLabel(p);
    const currentCat = (photoCatMap[p.id] || [])[0] || '';
    const checked = selectedPhotoIds.has(p.id);
    const catOpts =
      '<option value="">Sin cat.</option>' +
      categories
        .map((c) => `<option value="${c.id}" ${c.id === currentCat ? 'selected' : ''}>${escapeHtml(c.name)}</option>`)
        .join('');
    const el = document.createElement('div');
    el.className = 'admin-photo' + (isCover ? ' is-cover' : '') + (checked ? ' is-selected' : '');
    el.dataset.photoId = p.id;
    el.innerHTML = `
      <label class="admin-photo-check">
        <input type="checkbox" data-photo-select value="${escapeHtml(p.id)}" ${checked ? 'checked' : ''} aria-label="Seleccionar foto #${escapeHtml(code)}" />
      </label>
      <img src="${url}" alt="" loading="lazy" />
      <span class="admin-photo-code" title="Número de cámara / código pedido">#${escapeHtml(code)}</span>
      <div class="admin-photo-meta">
        <select data-photo-cat="${p.id}" aria-label="Categoría">${catOpts}</select>
      </div>
      <div class="admin-photo-actions">
        <button type="button" data-cover>Cover</button>
        <button type="button" data-del>Borrar</button>
      </div>
    `;
    el.querySelector('[data-photo-select]')?.addEventListener('change', (e) => {
      setPhotoSelected(p.id, !!e.target.checked);
      el.classList.toggle('is-selected', !!e.target.checked);
    });
    el.querySelector('[data-cover]')?.addEventListener('click', () => setCover(p));
    el.querySelector('[data-del]')?.addEventListener('click', () => deletePhoto(p));
    el.querySelector('[data-photo-cat]')?.addEventListener('change', async (e) => {
      try {
        await setPhotoCategory(p.id, e.target.value || '');
        showOk('Categoría actualizada');
        renderPhotos();
      } catch (err) {
        showError(err?.message || 'No se pudo guardar categoría');
        renderPhotos();
      }
    });
    return el;
  }

  function renderPhotos() {
    if (!photosEl) return;
    const still = new Set(photos.map((p) => p.id));
    selectedPhotoIds = new Set([...selectedPhotoIds].filter((id) => still.has(id)));
    photosEl.innerHTML = '';
    if (!photos.length) {
      photosEmpty && (photosEmpty.hidden = false);
      syncPhotoSelectBar();
      return;
    }
    photosEmpty && (photosEmpty.hidden = true);
    const groups = photoGroupsForAdmin();
    const multi = groups.length > 1 || (groups.length === 1 && groups[0].id !== '');
    if (!multi) {
      const grid = document.createElement('div');
      grid.className = 'admin-photos-grid';
      for (const p of photos) grid.appendChild(makeAdminPhotoTile(p));
      photosEl.appendChild(grid);
      syncPhotoSelectBar();
      return;
    }
    for (const g of groups) {
      const section = document.createElement('section');
      section.className = 'admin-photo-group';
      section.innerHTML = `<div class="admin-photo-group-head">
        <h3>${escapeHtml(g.name)}</h3>
        <span class="admin-muted">${g.photos.length} foto${g.photos.length === 1 ? '' : 's'}</span>
      </div>`;
      const grid = document.createElement('div');
      grid.className = 'admin-photos-grid';
      for (const p of g.photos) grid.appendChild(makeAdminPhotoTile(p));
      section.appendChild(grid);
      photosEl.appendChild(section);
    }
    syncPhotoSelectBar();
  }

  async function setCover(photo) {
    showError('');
    showOk('');
    try {
      const sb = getSupabase();
      const { error } = await sb
        .from('albums')
        .update({ cover_path: photo.preview_path, updated_at: new Date().toISOString() })
        .eq('id', albumId);
      if (error) throw error;
      album.cover_path = photo.preview_path;
      showOk('Cover actualizado');
      renderPhotos();
    } catch (err) {
      showError(err?.message || 'No se pudo setear cover');
    }
  }

  function isPhotoReferencedError(err) {
    const msg = String(err?.message || err?.details || err?.code || '');
    return (
      /foreign key|referenced|violates foreign|order_items|23503/i.test(msg) ||
      err?.code === '23503'
    );
  }

  /**
   * Borra storage + fila. No confirma. No muta el array photos.
   * @returns {Promise<{ ok: true } | { ok: false, reason: 'order' | 'error', message: string }>}
   */
  async function deletePhotoRow(photo, sb) {
    try {
      /** @type {{ kind: string, path: string }[]} */
      const storageItems = [];
      if (photo.preview_path) storageItems.push({ kind: BUCKETS.previews, path: photo.preview_path });
      if (photo.original_path) storageItems.push({ kind: BUCKETS.originals, path: photo.original_path });
      if (storageItems.length) await deleteStorageObjects(storageItems);
      try {
        await sb.from('face_embeddings').delete().eq('photo_id', photo.id);
      } catch (_) {
        /* optional table */
      }
      const { error } = await sb.from('photos').delete().eq('id', photo.id);
      if (error) {
        if (isPhotoReferencedError(error)) {
          return {
            ok: false,
            reason: 'order',
            message: `No se pudo borrar #${photoLabel(photo)}: está en un pedido`,
          };
        }
        return { ok: false, reason: 'error', message: error.message || 'No se pudo borrar' };
      }
      return { ok: true };
    } catch (err) {
      if (isPhotoReferencedError(err)) {
        return {
          ok: false,
          reason: 'order',
          message: `No se pudo borrar #${photoLabel(photo)}: está en un pedido`,
        };
      }
      return { ok: false, reason: 'error', message: err?.message || 'No se pudo borrar' };
    }
  }

  async function clearCoverIfNeeded(deletedPhotos, sb) {
    const cover = album?.cover_path;
    if (!cover) return;
    const hit = deletedPhotos.some(
      (p) => p.preview_path && (cover === p.preview_path || cover.endsWith(p.preview_path)),
    );
    if (!hit) return;
    await sb.from('albums').update({ cover_path: null }).eq('id', albumId);
    album.cover_path = null;
  }

  async function deletePhoto(photo) {
    if (!confirm('¿Borrar esta foto?')) return;
    showError('');
    try {
      const sb = getSupabase();
      const res = await deletePhotoRow(photo, sb);
      if (!res.ok) {
        showError(res.message);
        return;
      }
      await clearCoverIfNeeded([photo], sb);
      photos = photos.filter((p) => p.id !== photo.id);
      delete photoCatMap[photo.id];
      selectedPhotoIds.delete(photo.id);
      renderPhotos();
      showOk('Foto borrada');
    } catch (err) {
      showError(err?.message || 'No se pudo borrar');
    }
  }

  async function deletePhotosBulk(ids) {
    const unique = [...new Set(ids)].filter(Boolean);
    if (!unique.length) return;
    const targets = unique.map((id) => photos.find((p) => p.id === id)).filter(Boolean);
    if (!targets.length) return;
    const n = targets.length;
    if (
      !confirm(
        n === 1
          ? '¿Borrar 1 foto del evento? No se puede deshacer.'
          : `¿Borrar ${n} fotos del evento? No se puede deshacer.`,
      )
    ) {
      return;
    }
    showError('');
    showOk('');
    if (photoBulkStatus) {
      photoBulkStatus.hidden = false;
      photoBulkStatus.textContent = `Borrando 0/${n}…`;
    }
    const delBtn = root?.querySelector('[data-photo-delete-selected]');
    if (delBtn) delBtn.disabled = true;

    const sb = getSupabase();
    const deleted = [];
    const failed = [];

    // Pre-check: fotos en pedidos (barato si hay pocas; evita borrar storage al pedo)
    try {
      const { data: refs } = await sb.from('order_items').select('photo_id').in('photo_id', targets.map((p) => p.id));
      const blocked = new Set((refs || []).map((r) => r.photo_id).filter(Boolean));
      for (const p of targets) {
        if (blocked.has(p.id)) {
          failed.push({
            photo: p,
            message: `No se pudo borrar #${photoLabel(p)}: está en un pedido`,
          });
        }
      }
    } catch (_) {
      /* si no hay tabla / RLS, seguimos y el DELETE fallará con mensaje */
    }

    const blockedIds = new Set(failed.map((f) => f.photo.id));
    const toDelete = targets.filter((p) => !blockedIds.has(p.id));
    let done = 0;
    const totalWork = toDelete.length + failed.length;

    for (const photo of toDelete) {
      done += 1;
      if (photoBulkStatus) photoBulkStatus.textContent = `Borrando ${done}/${n}…`;
      const res = await deletePhotoRow(photo, sb);
      if (res.ok) deleted.push(photo);
      else failed.push({ photo, message: res.message });
    }

    void totalWork;
    if (deleted.length) {
      await clearCoverIfNeeded(deleted, sb);
      const gone = new Set(deleted.map((p) => p.id));
      photos = photos.filter((p) => !gone.has(p.id));
      for (const id of gone) {
        delete photoCatMap[id];
        selectedPhotoIds.delete(id);
      }
    }
    for (const f of failed) selectedPhotoIds.delete(f.photo.id);

    renderPhotos();
    if (photoBulkStatus) {
      photoBulkStatus.hidden = true;
      photoBulkStatus.textContent = '';
    }

    const parts = [];
    if (deleted.length) parts.push(`${deleted.length} borrada${deleted.length === 1 ? '' : 's'}`);
    if (failed.length) {
      parts.push(`${failed.length} no se pudieron (en un pedido o error)`);
      const detail = failed
        .slice(0, 5)
        .map((f) => f.message)
        .join(' · ');
      showError(detail + (failed.length > 5 ? ` · +${failed.length - 5} más` : ''));
    }
    if (deleted.length) showOk(`Listo: ${parts.join(' · ')}`);
    else if (!failed.length) showOk('Nada que borrar');
    syncPhotoSelectBar();
  }

  async function saveMetaAndTiers({ publish = false } = {}) {
    if (!form) throw new Error('Falta el formulario');
    const fd = new FormData(form);
    const name = String(fd.get('name') || '').trim();
    const slug = String(fd.get('slug') || '').trim();
    if (!name || !slug) throw new Error('Completá nombre y slug');
    const unit = readUnitPrice();
    const price_tiers = syncTiersWithUnit(unit, readTiers());
    const payload = {
      name,
      slug,
      date_label: String(fd.get('date_label') || '').trim() || null,
      kind: String(fd.get('kind') || 'event') === 'portfolio' ? 'portfolio' : 'event',
      photo_price_ars: unit,
      message: String(fd.get('message') || '').trim() || null,
      // eventos siempre con búsqueda por cara; portfolio también indexa al subir
      search_by_face: true,
      // Subir evento siempre publica; Guardar cambios (precios) no toca published
      ...(publish ? { published: true } : {}),
      price_tiers,
      updated_at: new Date().toISOString(),
    };
    const sb = getSupabase();
    const { data, error } = await sb.from('albums').update(payload).eq('id', albumId).select('*').single();
    if (error) throw error;
    album = data;
    fillForm();
    return data;
  }

  async function uploadQueuedFiles() {
    if (!queue.length) return { uploaded: 0, faces: 0, errors: 0 };
    const sb = getSupabase();
    const items = [...queue];
    let uploaded = 0;
    let faces = 0;
    let errors = 0;
    const startOrder = photos.reduce((m, p) => Math.max(m, p.sort_order || 0), 0);
    const usedCodes = new Set(photos.map((p) => String(p.code || '').toUpperCase()).filter(Boolean));
    // Siempre indexar TODAS las fotos subidas (eventos y portfolio vendible)
    const mustIndexFaces = true;

    for (let i = 0; i < items.length; i += 1) {
      const item = items[i];
      const file = item.file;
      const label = file.webkitRelativePath || file.name;
      try {
        setProgress(
          `Subiendo ${i + 1}/${items.length}: ${label}${item.categoryName ? ` · ${item.categoryName}` : ''}`,
        );
        // Defensa por si algo entró a la cola sin el filtro (límite bucket = 50 MB).
        if (typeof file.size === 'number' && file.size > ORIG_MAX_BYTES) {
          throw new Error(
            `${file.name}: pesa ${(file.size / (1024 * 1024)).toFixed(1)} MB (máx. ${ORIG_MAX_MB} MB). Exportá más liviana o bajá calidad y reintentá.`,
          );
        }
        const { previewBlob, width, height } = await makeWatermarkedPreview(file);
        const camCode = uniqueCameraCode(cameraCodeFromFilename(file.name), usedCodes);
        const base = `${albumId}/${camCode}-${Date.now().toString(36)}-${safeFileBase(file.name)}`;
        const previewPath = `${base}-wm.jpg`;

        const upPrev = await uploadWithRetry(BUCKETS.previews, previewPath, previewBlob, {
          contentType: 'image/jpeg',
          upsert: false,
          attempts: 4,
          onRetry: ({ attempt, attempts, delayMs }) => {
            setProgress(
              `Reintentando preview ${i + 1}/${items.length} (${attempt}/${attempts - 1})… ${label}`,
            );
            void delayMs;
          },
        });
        if (upPrev.error) {
          throw Object.assign(new Error(formatStorageError(upPrev.error, { fileName: file.name, kind: 'preview' })), {
            cause: upPrev.error,
          });
        }

        // Modo vitrina: no subimos el JPG de cámara. Sole entrega por fuera.
        let originalPath = null;
        if (!STOREFRONT_PREVIEWS_ONLY) {
          const ext = (file.name.split('.').pop() || 'jpg').toLowerCase().replace(/[^a-z0-9]/g, '') || 'jpg';
          originalPath = `${base}-full.${ext}`;
          const upOrig = await uploadWithRetry(BUCKETS.originals, originalPath, file, {
            contentType: file.type || 'image/jpeg',
            upsert: false,
            attempts: 5,
            baseDelayMs: 1200,
            onRetry: ({ attempt, attempts }) => {
              setProgress(
                `Reintentando original ${i + 1}/${items.length} (${attempt}/${attempts - 1})… ${label}`,
              );
            },
          });
          if (upOrig.error) {
            try {
              await removeStoragePaths(BUCKETS.previews, [previewPath]);
            } catch {
              /* best-effort */
            }
            throw Object.assign(new Error(formatStorageError(upOrig.error, { fileName: file.name, kind: 'original' })), {
              cause: upOrig.error,
            });
          }
        }

        const sort_order = startOrder + uploaded + 1;
        const insertPayload = {
          album_id: albumId,
          preview_path: previewPath,
          original_path: originalPath,
          width,
          height,
          sort_order,
          code: camCode,
          source_filename: file.name,
        };
        let { data: row, error } = await sb.from('photos').insert(insertPayload).select('*').single();
        if (error && /source_filename|code/i.test(error.message || '')) {
          delete insertPayload.source_filename;
          if (/code/i.test(error.message || '')) delete insertPayload.code;
          ({ data: row, error } = await sb.from('photos').insert(insertPayload).select('*').single());
        }
        if (error) throw error;
        if (!row.code) row.code = camCode;
        photos.push(row);

        if (item.categoryId) {
          try {
            await setPhotoCategory(row.id, item.categoryId);
          } catch (catErr) {
            errors += 1;
            const catMsg = catErr?.message || 'error al asignar categoría';
            console.warn('cat assign', catErr);
            showError(
              `Foto subida, pero sin categoría (${file.name} → ${item.categoryName || 'cat'}): ${catMsg}`,
            );
          }
        }

        if (!album.cover_path) {
          await sb.from('albums').update({ cover_path: previewPath }).eq('id', albumId);
          album.cover_path = previewPath;
        }

        if (mustIndexFaces) {
          try {
            setProgress(`Indexando caras ${i + 1}/${items.length}…`);
            const faceRes = await indexPhotoFacesWithRetry({
              photoId: row.id,
              albumId,
              image: previewBlob,
              attempts: 3,
            });
            faces += faceRes.faces || 0;
            row.rekognition_face_ids = faceRes.faceIds || [];
            row._faces = faceRes.faces;
            if (!faceRes.faces) {
              // sin cara en la foto: igual “indexada” (array vacío OK); no bloquea
              console.info('face index 0 faces', row.id);
            }
          } catch (faceErr) {
            errors += 1;
            console.warn('face index', faceErr);
            showError(
              `Foto subida, pero falló el índice de caras (${file.name}): ${
                faceErr?.message || 'error'
              }. Reintentá con Subir evento o revisá sesión admin.`,
            );
          }
        }

        uploaded += 1;
        // drop from queue as we go
        queue = queue.filter((q) => q.id !== item.id);
        renderQueue();
        // pequeña pausa entre fotos: menos 520 por ráfaga al edge de Supabase/CF
        if (i + 1 < items.length) {
          await new Promise((r) => setTimeout(r, 250));
        }
      } catch (err) {
        errors += 1;
        const msg =
          err?.message && !/^HTTP\s+\d+/i.test(String(err.message))
            ? String(err.message)
            : formatStorageError(err, { fileName: file.name });
        showError(msg);
      }
    }

    photos.sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0));
    await loadPhotoCategories();
    renderPhotos();
    return { uploaded, faces, errors };
  }

  /** Reindexa fotos del evento que todavía no tienen rekognition_face_ids */
  async function backfillMissingFaceIndex() {
    const missing = photos.filter((p) => !photoHasIndexedFaces(p) && p.preview_path);
    if (!missing.length) return { faces: 0, errors: 0, scanned: 0 };
    let faces = 0;
    let errors = 0;
    for (let i = 0; i < missing.length; i += 1) {
      const p = missing[i];
      try {
        setProgress(`Indexando caras pendientes ${i + 1}/${missing.length}…`);
        const url = publicStorageUrl(BUCKETS.previews, p.preview_path);
        const faceRes = await indexPhotoFacesWithRetry({
          photoId: p.id,
          albumId,
          image: url,
          attempts: 3,
        });
        faces += faceRes.faces || 0;
        p.rekognition_face_ids = faceRes.faceIds || [];
        p._faces = faceRes.faces;
      } catch (err) {
        errors += 1;
        console.warn('backfill face', p.id, err);
        showError(`No se indexó #${p.code || p.id}: ${err?.message || 'error'}`);
      }
    }
    return { faces, errors, scanned: missing.length };
  }

  /**
   * Re-bake preview JPEGs with the current single-logo watermark from private originals.
   * Needed when old uploads used the tiled pattern.
   */
  async function reapplyWatermarks() {
    if (busy) return;
    const withOrig = photos.filter((p) => p.original_path && p.preview_path);
    if (!withOrig.length) {
      showError(
        'No hay originales en la nube para remarcar. Los eventos nuevos solo guardan la vitrina (marca de agua). Si hace falta otro logo, re-subí las fotos.',
      );
      return;
    }
    if (
      !confirm(
        `¿Actualizar la marca de agua de ${withOrig.length} foto(s)? Usa el original guardado (eventos viejos) y deja un solo logo grande. Puede tardar un rato.`,
      )
    ) {
      return;
    }
    showError('');
    showOk('');
    setBusy(true);
    const sb = getSupabase();
    let ok = 0;
    let errors = 0;
    try {
      for (let i = 0; i < withOrig.length; i += 1) {
        const p = withOrig[i];
        const label = p.code || p.source_filename || p.id;
        setProgress(`Marca de agua ${i + 1}/${withOrig.length}: #${label}`);
        try {
          const signed = await presignStorage({
            kind: BUCKETS.originals,
            path: p.original_path,
            op: 'get',
            expiresIn: 600,
          });
          const res = await fetch(signed.url);
          if (!res.ok) throw new Error(`No se pudo bajar original HTTP ${res.status}`);
          const blob = await res.blob();
          const { previewBlob, width, height } = await makeWatermarkedPreview(blob);
          const up = await uploadWithRetry(BUCKETS.previews, p.preview_path, previewBlob, {
            contentType: 'image/jpeg',
            upsert: true,
            attempts: 4,
            onRetry: ({ attempt, attempts }) => {
              setProgress(
                `Reintentando marca ${i + 1}/${withOrig.length} (${attempt}/${attempts - 1})… #${label}`,
              );
            },
          });
          if (up.error) {
            throw Object.assign(new Error(formatStorageError(up.error, { kind: 'preview' })), {
              cause: up.error,
            });
          }
          if (width && height) {
            const { error: metaErr } = await sb
              .from('photos')
              .update({ width, height })
              .eq('id', p.id);
            if (metaErr) console.warn('photo meta', metaErr.message);
            p.width = width;
            p.height = height;
          }
          ok += 1;
        } catch (err) {
          errors += 1;
          console.warn('reapply wm', p.id, err);
          showError(`Falló #${p.code || p.id}: ${err?.message || 'error'}`);
        }
      }
      // bust cover cache if cover is a preview path
      if (album?.cover_path) {
        await sb
          .from('albums')
          .update({ updated_at: new Date().toISOString() })
          .eq('id', albumId);
      }
      renderPhotos();
      showOk(
        errors
          ? `Marcas: ${ok} ok · ${errors} con error. Hard refresh en la tienda.`
          : `Marcas actualizadas en ${ok} foto(s). Hard refresh en la tienda.`,
      );
    } finally {
      setBusy(false);
      clearProgressSoon();
      syncPublishEnabled();
    }
  }

  async function publishEvent() {
    if (busy) return;
    showError('');
    showOk('');
    setBusy(true);
    try {
      setProgress('Guardando datos del evento…');
      await saveMetaAndTiers({ publish: true });

      let uploaded = 0;
      let faces = 0;
      let errors = 0;
      if (queue.length) {
        const res = await uploadQueuedFiles();
        uploaded = res.uploaded;
        faces = res.faces;
        errors = res.errors;
      }

      // ensure published even if meta race / cover-only update left it false
      if (!album?.published) {
        const sb = getSupabase();
        const { data, error } = await sb
          .from('albums')
          .update({ published: true, updated_at: new Date().toISOString() })
          .eq('id', albumId)
          .select('*')
          .single();
        if (error) throw error;
        album = data;
      }

      // backfill: cualquier foto ya en el álbum sin caras
      const bf = await backfillMissingFaceIndex();
      faces += bf.faces;
      errors += bf.errors;

      fillForm();
      const parts = ['Evento guardado'];
      if (uploaded) parts.push(`${uploaded} foto(s) subidas`);
      if (faces) parts.push(`${faces} cara(s) indexadas`);
      if (bf.scanned && !bf.faces && !bf.errors) {
        parts.push('todas las fotos ya tenían caras indexadas');
      }
      if (bf.scanned && bf.errors) {
        parts.push(`${bf.errors}/${bf.scanned} pendientes de índice`);
      }
      if (album?.published) parts.push('publicado en la tienda');
      else parts.push('sigue en borrador');
      if (errors) parts.push(`${errors} con error`);
      showOk(parts.join(' · '));
    } catch (err) {
      showError(err?.message || 'No se pudo subir el evento');
    } finally {
      setBusy(false);
      clearProgressSoon();
      syncPublishEnabled();
      renderQueue();
    }
  }

  async function load() {
    if (!albumId) {
      showError('Falta id de evento (?id=…)');
      loadingEl && (loadingEl.hidden = true);
      return;
    }
    const gate = await requireAdminOrRedirect();
    if (!gate) return;

    try {
      const sb = getSupabase();
      const { data: a, error: aErr } = await sb.from('albums').select('*').eq('id', albumId).single();
      if (aErr) throw aErr;
      album = a;
      photos = await fetchAlbumPhotos(sb, albumId, '*');
      await loadCategories();
      await loadPhotoCategories();
      fillForm();
      renderPhotos();
      renderQueue();
      loadingEl && (loadingEl.hidden = true);
      readyEl && (readyEl.hidden = false);
      syncPublishEnabled();
    } catch (err) {
      loadingEl && (loadingEl.hidden = true);
      showError(err?.message || 'No se pudo cargar el evento');
    }
  }

  root?.querySelector('[data-add-tier]')?.addEventListener('click', () => {
    const unit = readUnitPrice() || album?.photo_price_ars || 5000;
    tiersEl?.appendChild(tierRow(3, Math.max(Math.round(unit * 2.5), unit + 1000)));
  });

  root?.querySelector('[data-save-prices]')?.addEventListener('click', async () => {
    if (busy) return;
    showError('');
    showOk('');
    try {
      const unit = readUnitPrice();
      const price_tiers = syncTiersWithUnit(unit, readTiers());
      const sb = getSupabase();
      const { data, error } = await sb
        .from('albums')
        .update({
          photo_price_ars: unit,
          price_tiers,
          updated_at: new Date().toISOString(),
        })
        .eq('id', albumId)
        .select('*')
        .single();
      if (error) throw error;
      album = data;
      fillForm();
      showOk(`Precios guardados · 1 foto ${formatArs(unit)}`);
    } catch (err) {
      showError(err?.message || 'No se pudieron guardar los precios');
    }
  });

  // if they edit unit price, mirror into pack qty=1 in the UI
  unitPriceInput?.addEventListener('change', () => {
    const unit = readUnitPrice();
    const rows = [...(tiersEl?.querySelectorAll('.admin-tier-row') || [])];
    let found = false;
    for (const row of rows) {
      const qty = Number(row.querySelector('[name="qty"]')?.value || 0);
      if (qty === 1) {
        const priceInput = row.querySelector('[name="price"]');
        if (priceInput) priceInput.value = String(unit);
        found = true;
        break;
      }
    }
    if (!found && tiersEl) tiersEl.prepend(tierRow(1, unit));
  });

  root?.querySelector('[data-delete-album]')?.addEventListener('click', async () => {
    const kindLabel = album?.kind === 'portfolio' ? 'álbum de portafolio' : 'evento';
    if (
      !confirm(
        `Esto borra el ${kindLabel} y sus fotos de la base y de la tienda. No se puede deshacer. ¿Seguro?`,
      )
    ) {
      return;
    }
    const btn = root.querySelector('[data-delete-album]');
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Borrando…';
    }
    try {
      const sb = getSupabase();
      const pathsP = photos.map((p) => p.preview_path).filter(Boolean);
      const pathsO = photos.map((p) => p.original_path).filter(Boolean);
      const cover = album?.cover_path ? [album.cover_path] : [];

      // storage best-effort (no bloquear si falla un path)
      if (pathsP.length) {
        try {
          await removeStoragePaths(BUCKETS.previews, pathsP);
        } catch (_) {}
      }
      if (cover.length) {
        try {
          await removeStoragePaths(BUCKETS.previews, cover);
        } catch (_) {}
        try {
          await removeStoragePaths(BUCKETS.covers, cover);
        } catch (_) {}
      }
      if (pathsO.length) {
        try {
          await removeStoragePaths(BUCKETS.originals, pathsO);
        } catch (_) {}
      }

      // FKs sin cascade en order_items → limpiar antes
      const { error: oiErr } = await sb.from('order_items').delete().eq('album_id', albumId);
      if (oiErr) console.warn('order_items cleanup', oiErr.message);

      // face_embeddings / categories / photos suelen cascade, pero borramos photos explícito por si RLS
      try {
        await sb.from('face_embeddings').delete().eq('album_id', albumId);
      } catch (_) {}
      const { error: phErr } = await sb.from('photos').delete().eq('album_id', albumId);
      if (phErr) throw phErr;

      const { data: deleted, error } = await sb.from('albums').delete().eq('id', albumId).select('id');
      if (error) throw error;
      if (!deleted?.length) {
        throw new Error(
          'No se borró el álbum (¿sin permiso o ya no existe?). Probá hard refresh en /admin.',
        );
      }

      window.location.assign('/admin');
    } catch (err) {
      showError(err?.message || 'No se pudo borrar');
      if (btn) {
        btn.disabled = false;
        btn.textContent =
          album?.kind === 'portfolio' ? 'Borrar álbum de portafolio' : 'Borrar evento';
      }
    }
  });

  root?.querySelector('[data-cat-add]')?.addEventListener('click', () => {
    addCategory(catNameInput?.value || '');
  });

  catNameInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      addCategory(catNameInput.value || '');
    }
  });

  root?.querySelector('[data-cat-seed]')?.addEventListener('click', () => {
    seedDefaultCategories();
  });

  root?.querySelector('[data-queue-clear]')?.addEventListener('click', clearQueue);

  root?.querySelector('[data-reapply-wm]')?.addEventListener('click', () => reapplyWatermarks());

  root?.querySelector('[data-photo-select-all]')?.addEventListener('click', () => {
    if (busy) return;
    for (const p of photos) selectedPhotoIds.add(p.id);
    renderPhotos();
  });

  root?.querySelector('[data-photo-select-none]')?.addEventListener('click', () => {
    if (busy) return;
    selectedPhotoIds.clear();
    renderPhotos();
  });

  root?.querySelector('[data-photo-delete-selected]')?.addEventListener('click', () => {
    if (busy) return;
    deletePhotosBulk([...selectedPhotoIds]);
  });

  publishBtns.forEach((btn) => {
    btn.addEventListener('click', () => publishEvent());
  });

  // prevent accidental enter-submit on meta form
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    publishEvent();
  });

  load();
</script>
