---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const albums = site.shop.albums;
const eventAlbums = albums.filter((a) => (a.kind || 'event') === 'event');
const portfolioAlbums = albums.filter((a) => a.kind === 'portfolio');
const currency = site.shop.currencySymbol;
---

<BaseLayout
  title={`${site.brand.name} — Tienda`}
  description="Comprá tus fotos de eventos. Buscá por selfie o llevate series del portafolio."
>
  <main class="page page--home">
    <header class="home-hero">
      <div class="home-hero-banner" aria-hidden="false">
        <img
          class="home-hero-bg"
          src="/images/fotoportada.jpg"
          alt=""
          width="1280"
          height="853"
          decoding="async"
          fetchpriority="high"
        />
        <div class="home-hero-overlay">
          <img
            class="home-hero-mark"
            src="/images/logosinfondo.png"
            alt={site.brand.name}
            width="542"
            height="150"
          />
        </div>
      </div>
      <div class="home-hero-copy">
        <p class="home-tag">{site.brand.tagline}</p>
        <p class="home-lead">{site.shop.intro}</p>
        <div class="home-cta">
          <a class="btn" href="/tienda/buscar">Buscar mis fotos</a>
          <a class="btn btn-ghost" href="#eventos">Ver álbumes</a>
        </div>
      </div>
    </header>

    <div class="shop-tools shop-tools--home">
      <input type="search" placeholder="Buscar evento o serie..." data-album-filter aria-label="Buscar" />
      <button type="button" class="btn btn-ghost" data-open-cart>Carrito</button>
    </div>

    <section class="shop-section shop-section--events" id="eventos" aria-labelledby="events-heading">
      <div class="shop-section-head">
        <h2 id="events-heading">{site.shop.events_title || 'Eventos'}</h2>
        <p class="shop-section-note">Álbumes de cada fecha.</p>
      </div>

      <div class="album-grid" data-album-grid data-section="events" data-live-events hidden></div>

      {
        eventAlbums.length === 0 ? (
          <div class="shop-empty" data-events-empty>
            <p>{site.shop.events_empty}</p>
          </div>
        ) : (
          <div class="album-grid" data-album-grid data-section="events-static">
            {eventAlbums.map((album) => (
              <a
                class="album-card"
                href={`/tienda/${album.id}`}
                data-album-name={`${album.name} ${album.date_label || ''}`.toLowerCase()}
              >
                <img src={album.cover} alt={album.name} loading="lazy" width="1000" height="625" />
                <div class="body">
                  <h3>{album.name}</h3>
                  <div class="meta">
                    {album.date_label} · {album.photo_count || album.photos.length} fotos
                  </div>
                  <div class="price-pill">
                    desde {currency}
                    {album.photo_price.toLocaleString('es-AR')}
                  </div>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </section>

    <section class="shop-section shop-section--portfolio" aria-labelledby="portfolio-heading">
      <div class="shop-section-head">
        <h2 id="portfolio-heading">{site.shop.portfolio_title || 'Del portafolio'}</h2>
        <p class="shop-section-note">{site.shop.portfolio_intro}</p>
      </div>

      <div class="album-grid album-grid--compact" data-album-grid data-section="portfolio">
        {
          portfolioAlbums.map((album) => (
            <a
              class="album-card album-card--compact"
              href={`/tienda/${album.id}`}
              data-album-name={`${album.name} ${album.date_label || ''}`.toLowerCase()}
            >
              <img src={album.cover} alt={album.name} loading="lazy" width="800" height="500" />
              <div class="body">
                <h3>{album.name}</h3>
                <div class="meta">
                  {album.date_label} · {album.photo_count || album.photos.length} fotos
                </div>
                <div class="price-pill">
                  desde {currency}
                  {album.photo_price.toLocaleString('es-AR')}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<script define:vars={{ currency }}>
  window.__SOLEPH_CURRENCY__ = currency || '$';
</script>

<script>
  import { isSupabaseConfigured } from '../lib/supabase.js';
  import { listPublishedAlbums } from '../lib/shop-live.js';

  const currency = window.__SOLEPH_CURRENCY__ || '$';
  const liveGrid = document.querySelector('[data-live-events]');
  const staticGrid = document.querySelector('[data-section="events-static"]');
  const empty = document.querySelector('[data-events-empty]');
  const input = document.querySelector('[data-album-filter]');

  function escapeHtml(s) {
    return String(s)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function cardHtml(album) {
    const name = escapeHtml(album.name || '');
    const date = escapeHtml(album.date_label || '');
    const count = Number(album.photo_count) || 0;
    const price = Number(album.photo_price_ars || album.photo_price || 0);
    const cover = escapeHtml(album.cover || '/images/logo.png');
    const href = `/tienda/evento?id=${encodeURIComponent(album.id)}`;
    const filter = `${album.name || ''} ${album.date_label || ''}`.toLowerCase();
    return `<a class="album-card" href="${href}" data-album-name="${escapeHtml(filter)}" data-live="1">
      <img src="${cover}" alt="${name}" loading="lazy" width="1000" height="625" />
      <div class="body">
        <h3>${name}</h3>
        <div class="meta">${date}${date ? ' · ' : ''}${count} fotos</div>
        <div class="price-pill">desde ${currency}${price.toLocaleString('es-AR')}</div>
      </div>
    </a>`;
  }

  async function hydrateLiveEvents() {
    if (!isSupabaseConfigured() || !liveGrid) return;
    try {
      const live = await listPublishedAlbums({ kind: 'event' });
      if (!live.length) return;
      liveGrid.hidden = false;
      liveGrid.innerHTML = live.map(cardHtml).join('');
      // hide static demo events when we have real ones
      if (staticGrid) staticGrid.hidden = true;
      if (empty) empty.hidden = true;
      bindFilter();
    } catch (err) {
      console.warn('live events', err);
    }
  }

  function bindFilter() {
    const cards = [...document.querySelectorAll('[data-album-name]')];
    input?.removeEventListener('input', onFilter);
    input?.addEventListener('input', onFilter);
    function onFilter() {
      const q = String(input.value || '')
        .trim()
        .toLowerCase();
      cards.forEach((card) => {
        const name = card.getAttribute('data-album-name') || '';
        card.style.display = !q || name.includes(q) ? '' : 'none';
      });
      if (empty && !liveGrid?.hidden) {
        const liveCards = cards.filter((c) => c.getAttribute('data-live') === '1');
        const any = liveCards.some((c) => c.style.display !== 'none');
        empty.hidden = liveCards.length > 0 && ( !q || any);
        if (liveCards.length && q && !any) {
          empty.hidden = false;
          empty.style.display = '';
        }
      }
    }
  }

  bindFilter();
  hydrateLiveEvents();
</script>
