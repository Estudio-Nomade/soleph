---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Evento" description="Fotos del evento">
  <main class="page" data-live-album>
    <p class="form-note" data-loading>Cargando álbum…</p>
    <p class="form-note" data-error hidden style="color:#8a1f1f;"></p>

    <div data-ready hidden>
      <header class="page-header">
        <h1 data-name>Evento</h1>
        <p data-sub></p>
      </header>

      <div class="album-top">
        <p class="lead" data-message></p>
        <div class="price-tiers" aria-label="Precios" data-tiers></div>
      </div>

      <section class="face-box" data-face-box hidden>
        <h2>Encontrá tus fotos por rostro</h2>
        <p>
          Mejor desde <a href="/tienda/buscar">Buscar mis fotos</a>: elegís el evento y subís un selfie.
        </p>
        <a class="btn" href="/tienda/buscar">Ir a buscar</a>
      </section>

      <div class="shop-tools" style="justify-content:flex-start; margin-bottom:1rem;">
        <button type="button" class="btn btn-ghost" data-open-cart>Ver carrito</button>
      </div>

      <section class="photo-grid" data-photo-grid></section>
      <p class="face-hint" data-empty hidden>Este evento todavía no tiene fotos publicadas.</p>
    </div>
  </main>
</BaseLayout>

<script>
  import { addToCart, removeFromCart, isInCart } from '../../scripts/cart.js';
  import { isSupabaseConfigured } from '../../lib/supabase.js';
  import { getPublishedAlbum } from '../../lib/shop-live.js';

  const root = document.querySelector('[data-live-album]');
  const loadingEl = root?.querySelector('[data-loading]');
  const errorEl = root?.querySelector('[data-error]');
  const readyEl = root?.querySelector('[data-ready]');
  const nameEl = root?.querySelector('[data-name]');
  const subEl = root?.querySelector('[data-sub]');
  const messageEl = root?.querySelector('[data-message]');
  const tiersEl = root?.querySelector('[data-tiers]');
  const faceBox = root?.querySelector('[data-face-box]');
  const grid = root?.querySelector('[data-photo-grid]');
  const emptyEl = root?.querySelector('[data-empty]');

  const albumId = new URLSearchParams(window.location.search).get('id');

  function showError(msg) {
    if (!errorEl) return;
    errorEl.hidden = !msg;
    errorEl.textContent = msg || '';
  }

  function syncSelected() {
    grid?.querySelectorAll('[data-photo]').forEach((tile) => {
      const id = tile.getAttribute('data-id');
      const on = id && isInCart(id);
      tile.classList.toggle('is-selected', !!on);
      const label = tile.querySelector('[data-add]');
      if (label) label.textContent = on ? 'En carrito' : 'Agregar';
    });
  }

  async function load() {
    if (!albumId) {
      loadingEl && (loadingEl.hidden = true);
      showError('Falta el evento (?id=…)');
      return;
    }
    if (!isSupabaseConfigured()) {
      loadingEl && (loadingEl.hidden = true);
      showError('Tienda no conectada a Supabase.');
      return;
    }
    try {
      const album = await getPublishedAlbum(albumId);
      loadingEl && (loadingEl.hidden = true);
      if (!album) {
        showError('Evento no encontrado o no publicado.');
        return;
      }

      document.title = `Soleph · ${album.name}`;
      if (nameEl) nameEl.textContent = album.name;
      if (subEl) {
        const kind = album.kind === 'portfolio' ? 'Portafolio' : 'Evento';
        subEl.textContent = `${kind}${album.date_label ? ` · ${album.date_label}` : ''} · ${album.photos.length} fotos`;
      }
      if (messageEl) {
        messageEl.textContent = album.message || 'Elegí las fotos y agregalas al carrito.';
      }

      const unit = Number(album.photo_price_ars) || 0;
      const tiers = Array.isArray(album.price_tiers) ? album.price_tiers : [];
      window.__SOLEPH_PRICE__ = { unitPrice: unit, tiers };

      if (tiersEl) {
        const bits = [`<span>1 foto · $${unit.toLocaleString('es-AR')}</span>`];
        for (const t of tiers) {
          if (Number(t.quantity) === 1) continue;
          bits.push(
            `<span>${Number(t.quantity)} fotos · $${Number(t.price).toLocaleString('es-AR')}</span>`,
          );
        }
        tiersEl.innerHTML = bits.join('');
      }

      if (faceBox) faceBox.hidden = album.search_by_face === false;

      if (!album.photos.length) {
        emptyEl && (emptyEl.hidden = false);
      } else if (grid) {
        emptyEl && (emptyEl.hidden = true);
        grid.innerHTML = '';
        for (const photo of album.photos) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'photo-tile';
          btn.dataset.photo = '';
          btn.dataset.id = photo.id;
          btn.dataset.code = photo.code || '';
          btn.dataset.src = photo.src;
          btn.dataset.thumb = photo.thumb || photo.src;
          btn.dataset.albumId = album.id;
          btn.dataset.albumName = album.name;
          btn.dataset.unit = String(unit);
          btn.innerHTML = `
            <img src="${photo.thumb || photo.src}" alt="" loading="lazy" width="600" height="600" />
            <span class="wm" aria-hidden="true">SOLE YAQUINTA</span>
            <span class="add" data-add>Agregar</span>
          `;
          btn.addEventListener('click', () => {
            const id = photo.id;
            if (isInCart(id)) removeFromCart(id);
            else {
              addToCart({
                id,
                code: photo.code || '',
                src: photo.src,
                thumb: photo.thumb || photo.src,
                albumId: album.id,
                albumName: album.name,
                unitPrice: unit,
              });
            }
            syncSelected();
          });
          grid.appendChild(btn);
        }
        syncSelected();
      }

      readyEl && (readyEl.hidden = false);
      window.addEventListener('soleph:cart', syncSelected);
    } catch (err) {
      loadingEl && (loadingEl.hidden = true);
      showError(err?.message || 'No se pudo cargar el evento');
    }
  }

  load();
</script>
