---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Evento"
  description="Fotos del evento"
  robots="noindex, nofollow, noai, noimageai"
>
  <main class="page" data-live-album>
    <p class="form-note" data-loading>Cargando álbum…</p>
    <p class="form-note" data-error hidden style="color:#8a1f1f;"></p>
    <p class="form-note" data-face-status hidden></p>

    <div data-ready hidden>
      <header class="page-header">
        <h1 data-name>Evento</h1>
        <p data-sub></p>
      </header>

      <div class="album-top">
        <p class="lead" data-message></p>
        <div class="price-tiers" aria-label="Precios" data-tiers></div>
      </div>

      <section class="face-box" data-face-box hidden>
        <h2>Encontrá tus fotos por rostro</h2>
        <p>
          Abrí una foto y tocá una cara, o andá a
          <a href="/tienda/buscar">Buscar mis fotos</a> con un selfie.
        </p>
        <a class="btn" href="/tienda/buscar">Ir a buscar</a>
      </section>

      <div class="shop-tools shop-tools--row" style="margin-bottom:1rem;">
        <div class="cat-chips" data-cat-chips hidden role="tablist" aria-label="Categorías"></div>
        <a class="btn btn-ghost" href="/tienda/carrito">Ir al carrito</a>
      </div>

      <div class="face-filter-bar" data-face-filter-bar hidden>
        <div class="face-filter-chip">
          <img data-face-filter-thumb src="" alt="" width="28" height="28" />
          <span data-face-filter-label>Fotos de esta persona</span>
          <button type="button" data-face-filter-clear>Ver todas</button>
        </div>
      </div>
      <h2 class="face-filter-title" data-face-filter-title hidden>Tus fotos</h2>

      <p class="face-hint" style="margin:0 0 0.75rem" data-album-hint>
        Tocá la foto para agrandarla. Si hay caras, tocá un recuadro para ver solo las de esa persona.
        Marcá el cuadrado para elegir y después <strong>Agregar al carrito</strong>.
      </p>

      <div data-album-sections></div>
      <p class="face-hint" data-empty hidden>Este evento todavía no tiene fotos publicadas.</p>
      <p class="face-hint" data-face-empty hidden>
        No encontramos más fotos de esta persona. Probá otra cara o
        <button type="button" class="btn btn-ghost" data-face-filter-clear-inline style="margin-left:0.35rem">
          ver todas
        </button>
      </p>
    </div>
  </main>
</BaseLayout>

<script>
  import { patchCartAlbumPricing } from '../../scripts/cart.js';
  import { isSupabaseConfigured } from '../../lib/supabase.js';
  import { getPublishedAlbum } from '../../lib/shop-live.js';
  import {
    loadStorefrontSettings,
    resolveAlbumMessage,
    DEFAULT_ALBUM_MESSAGE,
  } from '../../lib/settings.js';
  import {
    bindPhotoTile,
    ensureSelectBar,
    paintAllTiles,
    setLightboxOpenOpts,
  } from '../../scripts/shop-select.js';
  import {
    detectPhotoFaces,
    searchAlbumBySelfie,
    cropFaceFromImage,
    encodeCaraToken,
    decodeCaraToken,
  } from '../../lib/face.js';

  const root = document.querySelector('[data-live-album]');
  const loadingEl = root?.querySelector('[data-loading]');
  const errorEl = root?.querySelector('[data-error]');
  const faceStatusEl = root?.querySelector('[data-face-status]');
  const readyEl = root?.querySelector('[data-ready]');
  const nameEl = root?.querySelector('[data-name]');
  const subEl = root?.querySelector('[data-sub]');
  const messageEl = root?.querySelector('[data-message]');
  const tiersEl = root?.querySelector('[data-tiers]');
  const faceBox = root?.querySelector('[data-face-box]');
  const sectionsEl = root?.querySelector('[data-album-sections]');
  const chipsEl = root?.querySelector('[data-cat-chips]');
  const emptyEl = root?.querySelector('[data-empty]');
  const faceEmptyEl = root?.querySelector('[data-face-empty]');
  const faceFilterBar = root?.querySelector('[data-face-filter-bar]');
  const faceFilterLabel = root?.querySelector('[data-face-filter-label]');
  const faceFilterThumb = /** @type {HTMLImageElement | null} */ (
    root?.querySelector('[data-face-filter-thumb]')
  );
  const faceFilterTitle = root?.querySelector('[data-face-filter-title]');

  const params = new URLSearchParams(window.location.search);
  const albumId = params.get('id');

  /** @type {any} */
  let album = null;
  /** @type {string} '' = todas */
  let activeCat = '';
  /** @type {string[] | null} */
  let faceFilterIds = null;
  /** @type {string | null} */
  let faceFilterThumbSrc = null;
  /** @type {string | null} */
  let detectReqId = null;

  ensureSelectBar();

  function showError(msg) {
    if (!errorEl) return;
    errorEl.hidden = !msg;
    errorEl.textContent = msg || '';
  }

  function setFaceStatus(msg) {
    if (!faceStatusEl) return;
    faceStatusEl.hidden = !msg;
    faceStatusEl.textContent = msg || '';
  }

  function escapeHtml(s) {
    return String(s)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function faceSearchOn() {
    return album && album.search_by_face !== false;
  }

  function lb() {
    return window.solephLightbox;
  }

  function makeTile(photo, unit) {
    const el = document.createElement('div');
    el.className = 'photo-tile';
    el.dataset.photo = '';
    el.dataset.id = photo.id;
    const code = photo.code || String(photo.id || '').replace(/-/g, '').slice(0, 8).toUpperCase();
    el.dataset.code = code;
    el.dataset.src = photo.src;
    el.dataset.thumb = photo.thumb || photo.src;
    el.dataset.albumId = album.id;
    el.dataset.albumName = album.name;
    el.dataset.unit = String(unit);
    if (photo.categoryId) el.dataset.cat = photo.categoryId;
    el.dataset.wm = 'css';
    el.innerHTML = `
      <button type="button" class="photo-tile-open" data-open-photo aria-label="Ver #${escapeHtml(code)} en grande">
        <img src="${escapeHtml(photo.thumb || photo.src)}" alt="#${escapeHtml(code)}" loading="lazy" width="600" height="600" draggable="false" />
        <span class="wm-overlay" aria-hidden="true"></span>
      </button>
      <span class="photo-code-badge" title="Código de la foto">#${escapeHtml(code)}</span>
      <label class="photo-check" title="Elegir foto">
        <input type="checkbox" data-select aria-label="Elegir #${escapeHtml(code)}" />
        <span class="photo-check-box" aria-hidden="true"></span>
      </label>
      <span class="photo-in-cart" data-in-cart-mark hidden>En carrito</span>
    `;
    bindPhotoTile(el, sectionsEl || document);
    return el;
  }

  function groupPhotos() {
    const cats = Array.isArray(album?.categories) ? album.categories : [];
    const photos = Array.isArray(album?.photos) ? album.photos : [];
    /** @type {{ id: string, name: string, photos: any[] }[]} */
    const groups = cats.map((c) => ({
      id: c.id,
      name: c.name,
      photos: photos.filter((p) => (p.categoryIds || []).includes(c.id) || p.categoryId === c.id),
    }));
    const assigned = new Set(groups.flatMap((g) => g.photos.map((p) => p.id)));
    const uncategorized = photos.filter((p) => !assigned.has(p.id));
    if (uncategorized.length) {
      groups.push({ id: '', name: cats.length ? 'Sin categoría' : 'Todas', photos: uncategorized });
    }
    return groups.filter((g) => g.photos.length > 0);
  }

  function photosForGrid() {
    const all = Array.isArray(album?.photos) ? album.photos : [];
    if (!faceFilterIds) return all;
    const byId = new Map(all.map((p) => [p.id, p]));
    return faceFilterIds.map((id) => byId.get(id)).filter(Boolean);
  }

  function renderChips(groups) {
    if (!chipsEl) return;
    if (faceFilterIds) {
      chipsEl.hidden = true;
      chipsEl.innerHTML = '';
      return;
    }
    const multi = groups.length > 1;
    chipsEl.hidden = !multi;
    if (!multi) {
      chipsEl.innerHTML = '';
      return;
    }
    const total = album.photos.length;
    const items = [{ id: '', name: 'Todas', count: total }, ...groups.map((g) => ({ id: g.id, name: g.name, count: g.photos.length }))];
    const seen = new Set();
    const uniq = items.filter((it) => {
      const k = it.id || '__all__';
      if (seen.has(k)) return false;
      seen.add(k);
      return true;
    });
    chipsEl.innerHTML = uniq
      .map((it) => {
        const on = (it.id || '') === activeCat ? ' is-on' : '';
        return `<button type="button" class="cat-chip${on}" data-cat-filter="${escapeHtml(it.id || '')}" role="tab" aria-selected="${on ? 'true' : 'false'}">
          ${escapeHtml(it.name)} <span class="cat-chip-count">${it.count}</span>
        </button>`;
      })
      .join('');
    chipsEl.querySelectorAll('[data-cat-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCat = btn.getAttribute('data-cat-filter') || '';
        renderSections();
      });
    });
  }

  function paintFaceFilterChrome() {
    const on = !!faceFilterIds;
    if (faceFilterBar) faceFilterBar.hidden = !on;
    if (faceFilterTitle) faceFilterTitle.hidden = !on;
    if (faceFilterLabel && faceFilterIds) {
      const n = faceFilterIds.length;
      faceFilterLabel.textContent = n === 1 ? '1 foto de esta persona' : `${n} fotos de esta persona`;
    }
    if (faceFilterThumb) {
      if (faceFilterThumbSrc) {
        faceFilterThumb.src = faceFilterThumbSrc;
        faceFilterThumb.hidden = false;
      } else {
        faceFilterThumb.removeAttribute('src');
        faceFilterThumb.hidden = true;
      }
    }
    if (faceEmptyEl) {
      faceEmptyEl.hidden = !(on && faceFilterIds && faceFilterIds.length === 0);
    }
  }

  function renderSections() {
    if (!sectionsEl || !album) return;
    const unit = Number(album.photo_price_ars) || 0;
    const groups = groupPhotos();
    renderChips(groups);
    paintFaceFilterChrome();

    sectionsEl.innerHTML = '';
    if (!album.photos.length) {
      emptyEl && (emptyEl.hidden = false);
      return;
    }
    emptyEl && (emptyEl.hidden = true);

    // Face filter: only matches, order by search ranking
    if (faceFilterIds) {
      const list = photosForGrid();
      const section = document.createElement('section');
      section.className = 'album-cat-section';
      section.dataset.catSection = 'face';
      const grid = document.createElement('div');
      grid.className = 'photo-grid';
      for (const photo of list) grid.appendChild(makeTile(photo, unit));
      section.appendChild(grid);
      sectionsEl.appendChild(section);
      paintAllTiles(sectionsEl);
      return;
    }

    if (activeCat === '') {
      const section = document.createElement('section');
      section.className = 'album-cat-section';
      section.dataset.catSection = 'all';
      const grid = document.createElement('div');
      grid.className = 'photo-grid';
      for (const photo of album.photos) grid.appendChild(makeTile(photo, unit));
      section.appendChild(grid);
      sectionsEl.appendChild(section);
      paintAllTiles(sectionsEl);
      return;
    }

    const visible = groups.filter((g) => g.id === activeCat);
    for (const g of visible) {
      const section = document.createElement('section');
      section.className = 'album-cat-section';
      section.dataset.catSection = g.id || 'none';
      section.innerHTML = `<div class="shop-section-head album-cat-head">
            <h2>${escapeHtml(g.name)}</h2>
            <p class="shop-section-note">${g.photos.length} foto${g.photos.length === 1 ? '' : 's'}</p>
          </div>`;
      const grid = document.createElement('div');
      grid.className = 'photo-grid';
      for (const photo of g.photos) grid.appendChild(makeTile(photo, unit));
      section.appendChild(grid);
      sectionsEl.appendChild(section);
    }
    paintAllTiles(sectionsEl);
  }

  function setCaraInUrl(token) {
    const url = new URL(window.location.href);
    if (token) url.searchParams.set('cara', token);
    else url.searchParams.delete('cara');
    window.history.replaceState({}, '', url);
  }

  function clearFaceFilter() {
    faceFilterIds = null;
    faceFilterThumbSrc = null;
    setCaraInUrl(null);
    setFaceStatus('');
    renderSections();
  }

  /**
   * @param {{ photoIds: string[], thumbSrc?: string, token?: string }} args
   */
  function applyFaceFilter({ photoIds, thumbSrc, token }) {
    faceFilterIds = Array.isArray(photoIds) ? photoIds : [];
    faceFilterThumbSrc = thumbSrc || null;
    if (token) setCaraInUrl(token);
    setFaceStatus('');
    renderSections();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /**
   * @param {{ left: number, top: number, width: number, height: number }} box
   * @param {{ src: string, photoId?: string }} item
   */
  async function runFaceSearchFromBox(box, item) {
    if (!album || !faceSearchOn() || !item?.src || !item?.photoId) return;
    const api = lb();
    api?.setFaceLoading?.(true, 'Buscando fotos…');
    setFaceStatus('Buscando fotos de esta persona…');
    try {
      const crop = await cropFaceFromImage(item.src, box, { pad: 0.28, maxSide: 640 });
      const token = encodeCaraToken({ photoId: item.photoId, box });
      const result = await searchAlbumBySelfie({
        albumId: album.id,
        selfie: crop,
        limit: 100,
      });
      api?.close?.();
      if (result.noFace) {
        setFaceStatus('No se reconoció bien esa cara. Probá otra.');
        return;
      }
      applyFaceFilter({
        photoIds: result.photoIds || [],
        thumbSrc: crop,
        token,
      });
      if (!(result.photoIds || []).length) {
        setFaceStatus('No encontramos más fotos de esta persona.');
      }
    } catch (err) {
      console.warn('face click search', err);
      setFaceStatus(err?.message || 'No se pudo buscar esa cara.');
    } finally {
      api?.setFaceLoading?.(false);
    }
  }

  async function detectForCurrentItem(item) {
    if (!album || !faceSearchOn() || !item?.src) return;
    const api = lb();
    const req = `${item.photoId || item.src}:${Date.now()}`;
    detectReqId = req;
    api?.clearFaces?.();
    api?.setFaceLoading?.(true, 'Detectando caras…');
    try {
      const { faces } = await detectPhotoFaces({
        albumId: album.id,
        image: item.src,
        photoId: item.photoId,
      });
      if (detectReqId !== req) return;
      const cur = api?.current?.();
      if (cur && item.photoId && cur.photoId && cur.photoId !== item.photoId) return;
      api?.setFaces?.(faces || []);
    } catch (err) {
      console.warn('face detect', err);
      if (detectReqId === req) api?.clearFaces?.();
    } finally {
      if (detectReqId === req) api?.setFaceLoading?.(false);
    }
  }

  function wireLightboxFaces() {
    setLightboxOpenOpts(() => {
      if (!faceSearchOn()) return { faces: false };
      return {
        faces: true,
        onChange: (item) => {
          detectForCurrentItem(item);
        },
        onFaceClick: (face, item) => {
          runFaceSearchFromBox(face, item);
        },
      };
    });
  }

  async function hydrateCaraFromUrl() {
    if (!album || !faceSearchOn()) return;
    const token = new URLSearchParams(window.location.search).get('cara');
    if (!token) return;
    const decoded = decodeCaraToken(token);
    if (!decoded) return;
    const photo = (album.photos || []).find((p) => p.id === decoded.photoId);
    if (!photo?.src) {
      setFaceStatus('Ese link de cara ya no vale. Abrí una foto y tocá de nuevo.');
      setCaraInUrl(null);
      return;
    }
    setFaceStatus('Cargando fotos de esta persona…');
    try {
      const crop = await cropFaceFromImage(photo.src, decoded.box, { pad: 0.28, maxSide: 640 });
      const result = await searchAlbumBySelfie({
        albumId: album.id,
        selfie: crop,
        limit: 100,
      });
      applyFaceFilter({
        photoIds: result.photoIds || [],
        thumbSrc: crop,
        token,
      });
      if (!(result.photoIds || []).length) {
        setFaceStatus('No encontramos fotos para este link.');
      }
    } catch (err) {
      console.warn('cara hydrate', err);
      setFaceStatus(err?.message || 'No se pudo aplicar el filtro de cara.');
      setCaraInUrl(null);
    }
  }

  root?.querySelector('[data-face-filter-clear]')?.addEventListener('click', clearFaceFilter);
  root?.querySelector('[data-face-filter-clear-inline]')?.addEventListener('click', clearFaceFilter);

  async function load() {
    if (!albumId) {
      loadingEl && (loadingEl.hidden = true);
      showError('Falta el evento (?id=…)');
      return;
    }
    if (!isSupabaseConfigured()) {
      loadingEl && (loadingEl.hidden = true);
      showError('Tienda no conectada a Supabase.');
      return;
    }
    try {
      album = await getPublishedAlbum(albumId);
      loadingEl && (loadingEl.hidden = true);
      if (!album) {
        showError('Evento no encontrado o no publicado.');
        return;
      }

      document.title = `Soleph · ${album.name}`;
      if (nameEl) nameEl.textContent = album.name;
      if (subEl) {
        const kind = album.kind === 'portfolio' ? 'Portafolio' : 'Evento';
        const nCat = (album.categories || []).length;
        subEl.textContent = `${kind}${album.date_label ? ` · ${album.date_label}` : ''} · ${album.photos.length} fotos${
          nCat ? ` · ${nCat} categorías` : ''
        }`;
      }
      if (messageEl) {
        let msg = album.message || 'Elegí las fotos y agregalas al carrito.';
        try {
          const store = await loadStorefrontSettings({
            album_messages: { default: DEFAULT_ALBUM_MESSAGE },
          });
          msg = resolveAlbumMessage(
            [album.slug, album.id].filter(Boolean),
            store.album_messages,
            album.message,
            'Elegí las fotos y agregalas al carrito.',
            { preferOwn: true },
          );
        } catch (_) {
          /* keep album.message */
        }
        messageEl.textContent = msg;
      }

      const unit = Number(album.photo_price_ars) || 0;
      const tiers = Array.isArray(album.price_tiers) ? album.price_tiers : [];
      window.__SOLEPH_PRICE__ = { unitPrice: unit, tiers, albumId: album.id };
      patchCartAlbumPricing(album.id, { unitPrice: unit, albumName: album.name });

      if (tiersEl) {
        const bits = [`<span>1 foto · $${unit.toLocaleString('es-AR')}</span>`];
        for (const t of tiers) {
          if (Number(t.quantity) === 1) continue;
          bits.push(
            `<span>${Number(t.quantity)} fotos · $${Number(t.price).toLocaleString('es-AR')}</span>`,
          );
        }
        tiersEl.innerHTML = bits.join('');
      }

      if (faceBox) faceBox.hidden = album.search_by_face === false;

      const catParam = new URLSearchParams(window.location.search).get('cat');
      if (catParam && album.categories?.length) {
        const hit = album.categories.find(
          (c) => c.slug === catParam || c.id === catParam || c.name.toLowerCase() === catParam.toLowerCase(),
        );
        if (hit) activeCat = hit.id;
      }

      wireLightboxFaces();
      renderSections();
      readyEl && (readyEl.hidden = false);
      window.addEventListener('soleph:cart', () => paintAllTiles(sectionsEl || document));

      await hydrateCaraFromUrl();
    } catch (err) {
      loadingEl && (loadingEl.hidden = true);
      showError(err?.message || 'No se pudo cargar el evento');
    }
  }

  load();
</script>
