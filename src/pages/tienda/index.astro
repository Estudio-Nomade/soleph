---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.json';

const albums = site.shop.albums;
---

<BaseLayout
  title="Tienda"
  description="Comprá tus fotos de eventos. Buscá por álbum, dorsal o selfie."
>
  <main class="page">
    <div class="shop-hero">
      <h1>Tienda de fotos</h1>
      <p>{site.shop.intro}</p>
    </div>

    <div class="shop-tools">
      <input type="search" placeholder="Buscar evento..." data-album-filter aria-label="Buscar evento" />
      <a class="btn" href="/tienda/buscar">Buscar mis fotos</a>
      <button type="button" class="btn btn-ghost" data-open-cart>Carrito</button>
    </div>

    <section class="album-grid" data-album-grid>
      {
        albums.map((album) => (
          <a class="album-card" href={`/tienda/${album.id}`} data-album-name={album.name.toLowerCase()}>
            <img src={album.cover} alt={album.name} loading="lazy" width="1000" height="625" />
            <div class="body">
              <h2>{album.name}</h2>
              <div class="meta">
                {album.date_label} · {album.photo_count || album.photos.length} fotos
              </div>
              <div class="price-pill">
                desde {site.shop.currencySymbol}
                {album.photo_price.toLocaleString('es-AR')}
              </div>
            </div>
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>

<script>
  const input = document.querySelector('[data-album-filter]');
  const cards = [...document.querySelectorAll('[data-album-name]')];
  input?.addEventListener('input', () => {
    const q = String(input.value || '')
      .trim()
      .toLowerCase();
    cards.forEach((card) => {
      const name = card.getAttribute('data-album-name') || '';
      card.style.display = !q || name.includes(q) ? '' : 'none';
    });
  });
</script>
