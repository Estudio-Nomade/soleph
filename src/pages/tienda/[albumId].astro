---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.json';

export function getStaticPaths() {
  return site.shop.albums.map((album) => ({
    params: { albumId: album.id },
    props: { album },
  }));
}

const { album } = Astro.props;
const unit = album.photo_price;
const tiers = album.price_tiers;
const isPortfolio = album.kind === 'portfolio';
const initialMessage =
  album.message ||
  'Alta resolución. Cuando confirmamos la transferencia por WhatsApp, te la mando por ahí.';
---

<BaseLayout title={album.name} description={`Comprá fotos de ${album.name}`} ogImage={album.cover}>
  <main class="page">
    <header class="page-header">
      <h1>{album.name}</h1>
      <p>
        {isPortfolio ? 'Portafolio · ' : 'Evento · '}
        {album.date_label} · {album.photos.length} fotos
      </p>
    </header>

    <div class="album-top">
      <p class="lead" data-album-message>{initialMessage}</p>
      <div class="price-tiers" aria-label="Precios">
        <span>1 foto · ${unit.toLocaleString('es-AR')}</span>
        {
          tiers.map((t) => (
            <span>
              {t.quantity} fotos · ${t.price.toLocaleString('es-AR')}
            </span>
          ))
        }
      </div>
    </div>

    {
      album.search_by_face && (
        <section class="face-box">
          <h2>Encontrá tus fotos por rostro</h2>
          <p>Subí un selfie o sacate una foto. Te filtramos las que coinciden con tu cara.</p>
          <div class="face-row">
            <input type="file" accept="image/*" capture="user" data-face-input aria-label="Subir selfie" />
            <img class="face-preview" data-face-preview alt="Vista previa del selfie" />
            <button type="button" class="btn btn-ghost" data-face-clear hidden>Limpiar</button>
          </div>
        </section>
      )
    }

    <p class="face-hint" style="margin:0 0 0.75rem">
      Tocá la foto para agrandarla. Marcá el cuadrado para elegir una o varias y después
      <strong>Agregar al carrito</strong>.
    </p>

    <div class="shop-tools" style="justify-content:flex-start; margin-bottom:1rem;">
      <a class="btn btn-ghost" href="/tienda/carrito">Ir al carrito</a>
    </div>

    <section class="photo-grid" data-photo-grid>
      {
        album.photos.map((photo) => {
          const code =
            photo.code || String(photo.id).replace(/-/g, '').slice(0, 8).toUpperCase();
          return (
            <div
              class="photo-tile"
              data-photo
              data-id={photo.id}
              data-code={code}
              data-src={photo.src}
              data-thumb={photo.thumb}
              data-album-id={album.id}
              data-album-name={album.name}
              data-unit={unit}
            >
              <button type="button" class="photo-tile-open" data-open-photo aria-label={`Ver #${code} en grande`}>
                <img src={photo.thumb} alt={`#${code}`} loading="lazy" width="600" height="600" />
                <span class="wm-overlay" aria-hidden="true" />
              </button>
              <span class="photo-code-badge">#{code}</span>
              <label class="photo-check" title="Elegir foto">
                <input type="checkbox" data-select aria-label={`Elegir #${code}`} />
                <span class="photo-check-box" aria-hidden="true" />
              </label>
              <span class="photo-in-cart" data-in-cart-mark hidden>
                En carrito
              </span>
            </div>
          );
        })
      }
    </section>
  </main>
</BaseLayout>

<script define:vars={{ unit, tiers, albumId: album.id, albumMessage: initialMessage }}>
  window.__SOLEPH_PRICE__ = { unitPrice: unit, tiers };
  window.__SOLEPH_ALBUM_ID__ = albumId;
  window.__SOLEPH_ALBUM_MESSAGE__ = albumMessage;
</script>

<script>
  import { isSupabaseConfigured } from '../../lib/supabase.js';
  import { loadStorefrontSettings, resolveAlbumMessage, DEFAULT_ALBUM_MESSAGE } from '../../lib/settings.js';
  import { bindPhotoGrid, ensureSelectBar } from '../../scripts/shop-select.js';

  // hydrate message from admin storefront settings (sin redeploy)
  (async () => {
    const el = document.querySelector('[data-album-message]');
    const albumId = window.__SOLEPH_ALBUM_ID__ || '';
    const own = window.__SOLEPH_ALBUM_MESSAGE__ || '';
    if (!el || !isSupabaseConfigured()) return;
    try {
      const store = await loadStorefrontSettings({
        album_messages: { default: DEFAULT_ALBUM_MESSAGE },
      });
      const msg = resolveAlbumMessage(albumId, store.album_messages, own, DEFAULT_ALBUM_MESSAGE);
      if (msg) el.textContent = msg;
    } catch (err) {
      console.warn('album message', err);
    }
  })();

  ensureSelectBar();
  bindPhotoGrid(document.querySelector('[data-photo-grid]') || document);

  const faceInput = document.querySelector('[data-face-input]');
  const facePreview = document.querySelector('[data-face-preview]');
  const faceClear = document.querySelector('[data-face-clear]');
  const allTiles = [...document.querySelectorAll('[data-photo]')];
  const params = new URLSearchParams(window.location.search);

  function applyDemoFaceFilter(seed = 'selfie') {
    let hash = 0;
    for (let i = 0; i < seed.length; i++) hash = (hash + seed.charCodeAt(i) * (i + 1)) % 997;
    allTiles.forEach((tile, i) => {
      tile.style.display = (hash + i * 17) % 10 < 4 ? '' : 'none';
    });
  }

  function resetFaceFilter() {
    allTiles.forEach((t) => (t.style.display = ''));
    if (facePreview) {
      facePreview.removeAttribute('src');
      facePreview.classList.remove('is-on');
    }
    faceClear?.setAttribute('hidden', '');
    if (faceInput) faceInput.value = '';
  }

  if (params.get('face') === '1' || sessionStorage.getItem('soleph-face-demo') === '1') {
    sessionStorage.removeItem('soleph-face-demo');
    applyDemoFaceFilter(sessionStorage.getItem('soleph-face-name') || 'selfie');
  }

  faceInput?.addEventListener('change', () => {
    const file = faceInput.files?.[0];
    if (!file) return;
    const url = URL.createObjectURL(file);
    if (facePreview) {
      facePreview.src = url;
      facePreview.classList.add('is-on');
    }
    faceClear?.removeAttribute('hidden');
    applyDemoFaceFilter(file.name + String(file.size));
  });

  faceClear?.addEventListener('click', resetFaceFilter);
</script>
