---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.json';
import { loadTransferSettings } from '../../lib/settings.js';

const sample = site.shop.albums[0];
const unit = sample?.photo_price ?? 5000;
const tiers = sample?.price_tiers ?? [];
const formats = site.shop.formats || {
  default: 'redes',
  options: [
    { id: 'redes', label: 'Para redes', hint: 'Archivo liviano, listo para subir.' },
    { id: 'impresion', label: 'Para impresión', hint: 'Alta resolución para imprimir.' },
  ],
};
const wa = site.brand.whatsapp_digits || '5492494550855';
const transfer = await loadTransferSettings(site.shop.transfer || { owner: 'Sole Yaquinta', alias: null, cbu: null });
---

<BaseLayout title="Carrito" description="Transferí y mandá el pedido a Sole por WhatsApp">
  <main class="page">
    <header class="page-header">
      <h1>Carrito</h1>
      <p>Elegí el formato, transferí el total y abrí WhatsApp para mandar el pedido con el comprobante.</p>
    </header>

    <div class="checkout-grid">
      <section>
        <div data-cart-page-list class="checkout-summary">
          <h2>Fotos elegidas</h2>
          <div class="cart-empty">El carrito está vacío.</div>
        </div>
      </section>

      <section class="checkout-summary">
        <h2>Pago por transferencia</h2>
        <div class="cart-total" style="margin-bottom:0.75rem;">
          <span>Total a transferir</span>
          <span data-page-total>$0</span>
        </div>
        <div class="tier-hint" data-page-tier></div>

        <div class="transfer-box is-on" data-transfer-box>
          <div><strong>Titular:</strong> {transfer.owner || 'Sole Yaquinta'}</div>
          <div data-transfer-alias>
            <strong>Alias:</strong>
            {
              transfer.alias ? (
                <span class="transfer-value">{transfer.alias}</span>
              ) : (
                <span>Sole te lo confirma por WhatsApp si hace falta</span>
              )
            }
          </div>
          {
            transfer.cbu && (
              <div>
                <strong>CBU/CVU:</strong> <span class="transfer-value">{transfer.cbu}</span>
              </div>
            )
          }
          {transfer.bank && <div class="field-hint" style="margin-top:0.35rem;">{transfer.bank}</div>}
          <p class="field-hint" style="margin-top:0.65rem;">
            1) Transferí el total · 2) Abrí WhatsApp con el pedido · 3) Adjuntá el comprobante en ese chat.
          </p>
        </div>

        <form class="contact-form" data-checkout-form style="max-width:none; margin-top:1rem;" data-wa={wa}>
          <div class="field">
            <label for="c-name">Nombre *</label>
            <input id="c-name" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="c-phone">Tu WhatsApp *</label>
            <input
              id="c-phone"
              name="phone"
              type="tel"
              required
              autocomplete="tel"
              placeholder="Para enviarte las fotos"
            />
          </div>

          <label class="pay-option" style="margin:0.25rem 0 0.75rem;">
            <input type="checkbox" name="paid" value="1" required data-paid />
            <div>
              <strong>Ya transferí el total</strong>
              <span>Y voy a adjuntar el comprobante cuando se abra WhatsApp.</span>
            </div>
          </label>

          <button class="btn btn-block" type="submit">Abrir WhatsApp</button>
        </form>

        <div class="form-success" data-checkout-success>
          Pedido listo. En el chat de WhatsApp adjuntá el comprobante.
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ unit, tiers, formats, wa, transfer }}>
  window.__SOLEPH_PRICE__ = { unitPrice: unit, tiers };
  window.__SOLEPH_FORMATS__ = formats;
  window.__SOLEPH_WA__ = wa;
  window.__SOLEPH_TRANSFER__ = transfer;
</script>

<script>
  import {
    getCart,
    removeFromCart,
    setItemFormat,
    clearCart,
    formatARS,
    formatLabel,
    priceForQuantity,
    DEFAULT_FORMAT,
  } from '../../scripts/cart.js';
  import { isSupabaseConfigured, getSupabase } from '../../lib/supabase.js';

  const list = document.querySelector('[data-cart-page-list]');
  const totalEl = document.querySelector('[data-page-total]');
  const tierEl = document.querySelector('[data-page-tier]');
  const form = document.querySelector('[data-checkout-form]');
  const ok = document.querySelector('[data-checkout-success]');
  const paidCheck = document.querySelector('[data-paid]');
  const transferBox = document.querySelector('[data-transfer-box]');
  const price = window.__SOLEPH_PRICE__ || { unitPrice: 5000, tiers: [] };
  const formats = window.__SOLEPH_FORMATS__ || {
    default: DEFAULT_FORMAT,
    options: [
      { id: 'redes', label: 'Para redes' },
      { id: 'impresion', label: 'Para impresión' },
    ],
  };
  const wa = window.__SOLEPH_WA__ || form?.getAttribute('data-wa') || '5492494550855';
  let transfer = window.__SOLEPH_TRANSFER__ || {};

  function escapeHtml(s) {
    return String(s)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;');
  }

  function paintTransfer(t) {
    if (!transferBox || !t) return;
    const aliasHtml = t.alias
      ? `<span class="transfer-value">${escapeHtml(t.alias)}</span>`
      : '<span>Sole te lo confirma por WhatsApp si hace falta</span>';
    transferBox.innerHTML = `
      <div><strong>Titular:</strong> ${escapeHtml(t.owner || 'Sole Yaquinta')}</div>
      <div data-transfer-alias><strong>Alias:</strong> ${aliasHtml}</div>
      ${t.cbu ? `<div><strong>CBU/CVU:</strong> <span class="transfer-value">${escapeHtml(t.cbu)}</span></div>` : ''}
      ${t.bank ? `<div class="field-hint" style="margin-top:0.35rem;">${escapeHtml(t.bank)}</div>` : ''}
      <p class="field-hint" style="margin-top:0.65rem;">
        1) Transferí el total · 2) Abrí WhatsApp con el pedido · 3) Adjuntá el comprobante en ese chat.
      </p>
    `;
  }

  async function refreshTransferFromDb() {
    if (!isSupabaseConfigured()) return;
    try {
      const sb = getSupabase();
      const { data, error } = await sb.from('settings').select('value').eq('key', 'storefront').maybeSingle();
      if (error) throw error;
      const t = data?.value?.transfer;
      if (!t || typeof t !== 'object') return;
      transfer = {
        owner: t.owner || transfer.owner || 'Sole Yaquinta',
        alias: t.alias ?? null,
        cbu: t.cbu ?? null,
        bank: t.bank ?? null,
      };
      window.__SOLEPH_TRANSFER__ = transfer;
      paintTransfer(transfer);
    } catch (err) {
      console.warn('transfer refresh', err);
    }
  }

  function formatSelect(item) {
    const current = item.format || formats.default || DEFAULT_FORMAT;
    const opts = (formats.options || [])
      .map(
        (opt) =>
          `<option value="${opt.id}" ${opt.id === current ? 'selected' : ''}>${opt.label}</option>`
      )
      .join('');
    return `<label class="format-field">
      <span class="sr-only">Formato</span>
      <select data-format="${item.id}" aria-label="Formato de ${item.id}">${opts}</select>
    </label>`;
  }

  function render() {
    const items = getCart();
    const total = priceForQuantity(items.length, price.unitPrice, price.tiers || []);
    if (totalEl) totalEl.textContent = formatARS(total);

    if (tierEl) {
      const tiersList = price.tiers || [];
      const next = [...tiersList].sort((a, b) => a.quantity - b.quantity).find((t) => items.length < t.quantity);
      tierEl.textContent = next
        ? `Con ${next.quantity} fotos el pack queda en ${formatARS(next.price)}.`
        : items.length
          ? 'Precio de pack aplicado.'
          : '';
    }

    if (!list) return;
    if (!items.length) {
      list.innerHTML =
        '<h2>Fotos elegidas</h2><div class="cart-empty">El carrito está vacío. <a href="/">Ir a la tienda</a></div>';
      return;
    }

    list.innerHTML =
      '<h2>Fotos elegidas</h2>' +
      items
        .map(
          (item) => `
      <div class="cart-item cart-item--format">
        <img src="${item.thumb || item.src}" alt="" width="72" height="72" />
        <div class="info">
          <strong>${item.albumName || 'Foto'}</strong>
          <span class="photo-code">#${item.code || item.id}</span>
          ${formatSelect(item)}
          <span class="format-current">${formatLabel(item.format)}</span>
        </div>
        <button type="button" class="remove" data-remove="${item.id}">Quitar</button>
      </div>`
        )
        .join('');

    list.querySelectorAll('[data-remove]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-remove');
        if (id) removeFromCart(id);
      });
    });

    list.querySelectorAll('[data-format]').forEach((sel) => {
      sel.addEventListener('change', () => {
        const id = sel.getAttribute('data-format');
        if (id) setItemFormat(id, sel.value);
      });
    });
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const items = getCart();
    if (!items.length) {
      alert('El carrito está vacío.');
      return;
    }

    const fd = new FormData(form);
    const name = String(fd.get('name') || '').trim();
    const phone = String(fd.get('phone') || '').trim();
    const paid = Boolean(paidCheck?.checked);

    if (!name || !phone) {
      alert('Completá nombre y WhatsApp.');
      return;
    }
    if (!paid) {
      alert('Confirmá que ya transferiste el total.');
      return;
    }

    const total = priceForQuantity(items.length, price.unitPrice, price.tiers || []);
    const orderId = 'ORD-' + Date.now().toString(36).toUpperCase();
    const transferLine = [
      transfer.owner || 'Sole Yaquinta',
      transfer.alias ? `alias ${transfer.alias}` : null,
      transfer.cbu ? transfer.cbu : null,
    ]
      .filter(Boolean)
      .join(' · ');

    const lines = [
      `Hola Sole, ya transferí y te mando el pedido de fotos.`,
      ``,
      `Pedido: ${orderId}`,
      `Nombre: ${name}`,
      `Mi WhatsApp: ${phone}`,
      `Pago: Transferencia`,
      `Total transferido: ${formatARS(total)}`,
      transferLine ? `Datos usados: ${transferLine}` : null,
      ``,
      `Fotos:`,
      ...items.map((item, i) => {
        const fmt = formatLabel(item.format || DEFAULT_FORMAT);
        const code = item.code || String(item.id || '').replace(/-/g, '').slice(0, 8).toUpperCase();
        return `${i + 1}. ${item.albumName || 'Álbum'} — #${code} — ${fmt}`;
      }),
      ``,
      `Te adjunto el comprobante en este chat.`,
      ``,
      `Gracias!`,
    ].filter((x) => x !== null);

    const order = {
      id: orderId,
      createdAt: new Date().toISOString(),
      name,
      phone,
      pay: 'transferencia',
      items: items.map((item) => ({ ...item, format: item.format || DEFAULT_FORMAT })),
      total,
      currency: 'ARS',
      channel: 'whatsapp',
    };
    localStorage.setItem('soleph-last-order', JSON.stringify(order));

    const url = `https://wa.me/${wa}?text=${encodeURIComponent(lines.join('\n'))}`;
    window.open(url, '_blank', 'noopener');

    clearCart();
    form.style.display = 'none';
    ok?.classList.add('is-visible');
    render();
  });

  window.addEventListener('soleph:cart', render);
  render();
  refreshTransferFromDb();
</script>
