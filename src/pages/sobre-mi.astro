---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

const paragraphs = site.about.body.split(/\n+/).filter(Boolean);
const lead = paragraphs[0] || '';
const wa = site.brand.whatsapp_digits || '5492494550855';
---

<BaseLayout title="Sobre mí" description={lead} ogImage={site.about.image}>
  <main class="page page--about">
    <section class="about-hero">
      <div class="about-photo">
        <img src={site.about.image} alt={site.brand.name} width="1200" height="1500" loading="eager" />
      </div>

      <div class="about-copy-col">
        <p class="about-kicker">{site.brand.tagline}</p>
        <h1>Sobre mí</h1>
        <p class="about-place">{site.brand.location}</p>

        <div class="about-body">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <div class="about-actions">
          <a class="btn" href={`https://wa.me/${wa}`} target="_blank" rel="noopener">Escribime</a>
          <a class="btn btn-ghost" href="/trabajos">Ver trabajos</a>
        </div>
      </div>
    </section>

    <section class="related about-related">
      <h2>También te puede interesar</h2>
      <div class="related-grid">
        {
          site.projects.slice(0, 3).map((p) => (
            <a class="related-card" href={p.href}>
              <img src={p.cover} alt={p.title} loading="lazy" width="800" height="600" />
              <div class="label">
                <strong>{p.title}</strong>
                <span>{p.year}</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
