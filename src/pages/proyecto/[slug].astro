---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import site from '../../data/site.json';

export function getStaticPaths() {
  return site.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const related = site.projects.filter((p) => p.slug !== project.slug).slice(0, 3);
---

<BaseLayout title={project.title} ogImage={project.cover} description={`${project.title} — ${site.brand.name}`}>
  <main class="page">
    <header class="page-header">
      <h1>{project.title}</h1>
    </header>

    <section class="gallery" data-gallery aria-label={`Galería ${project.title}`}>
      {
        project.images.map((src, i) => (
          <figure data-full={src} class={i >= 3 && i % 4 === 0 ? 'wide' : undefined}>
            <img
              src={src}
              alt={`${project.title} ${i + 1}`}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
              fetchpriority={i === 0 ? 'high' : 'auto'}
              width="1600"
              height="1200"
              sizes="(min-width: 933px) 48vw, 100vw"
            />
          </figure>
        ))
      }
    </section>

    {
      related.length > 0 && (
        <section class="related">
          <h2>También te puede interesar</h2>
          <div class="related-grid">
            {related.map((p) => (
              <a class="related-card" href={p.href}>
                <img
                  src={p.cover}
                  alt={p.title}
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="600"
                  sizes="(min-width: 933px) 30vw, 100vw"
                />
                <div class="label">
                  <strong>{p.title}</strong>
                  <span>{p.year}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>
  <Lightbox />
</BaseLayout>
