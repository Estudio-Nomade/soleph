---
---

<div class="cart-backdrop" data-cart-backdrop></div>
<aside class="cart-drawer" data-cart-drawer aria-label="Carrito" aria-hidden="true">
  <div class="cart-head">
    <h2>Carrito</h2>
    <button type="button" class="icon-btn" data-close-cart aria-label="Cerrar">×</button>
  </div>
  <div class="cart-body" data-cart-body>
    <div class="cart-empty">Todavía no hay fotos.</div>
  </div>
  <div class="cart-foot">
    <div class="tier-hint" data-cart-tier></div>
    <div class="cart-total">
      <span>Total</span>
      <span data-cart-total>$0</span>
    </div>
    <a class="btn btn-block" href="/tienda/carrito">Ver carrito y pagar</a>
  </div>
</aside>

<script>
  import {
    getCart,
    removeFromCart,
    formatARS,
    formatLabel,
    cartTotalByAlbums,
  } from '../scripts/cart.js';
  import { loadAlbumPrices } from '../lib/settings.js';

  const drawer = document.querySelector('[data-cart-drawer]');
  const backdrop = document.querySelector('[data-cart-backdrop]');
  const body = document.querySelector('[data-cart-body]');
  const totalEl = document.querySelector('[data-cart-total]');
  const tierEl = document.querySelector('[data-cart-tier]');
  const countEls = () => document.querySelectorAll('[data-cart-count]');

  /** @type {Record<string, { unit: number, tiers: any[] }>} */
  let albumPrices = {};
  let pricesLoadedFor = '';

  function openCart() {
    drawer?.classList.add('is-open');
    backdrop?.classList.add('is-open');
    drawer?.setAttribute('aria-hidden', 'false');
    refreshPrices().then(render);
  }

  function closeCart() {
    drawer?.classList.remove('is-open');
    backdrop?.classList.remove('is-open');
    drawer?.setAttribute('aria-hidden', 'true');
  }

  async function refreshPrices() {
    const items = getCart();
    const ids = items.map((i) => i.albumId).filter(Boolean);
    const key = ids.slice().sort().join(',');
    if (key === pricesLoadedFor && Object.keys(albumPrices).length) return;
    try {
      albumPrices = await loadAlbumPrices(ids);
      pricesLoadedFor = key;
      // expose for pages that only set single album price
      const first = ids[0] && albumPrices[ids[0]];
      if (first) {
        window.__SOLEPH_PRICE__ = {
          unitPrice: first.unit,
          tiers: first.tiers,
          albumId: ids[0],
        };
      }
    } catch (err) {
      console.warn('drawer prices', err);
    }
  }

  function render() {
    const items = getCart();
    const { total, groups } = cartTotalByAlbums(items, albumPrices);

    countEls().forEach((el) => {
      el.textContent = items.length ? String(items.length) : '';
      el.setAttribute('data-count', String(items.length));
    });

    if (totalEl) totalEl.textContent = formatARS(total);

    if (tierEl) {
      if (!items.length) tierEl.textContent = '';
      else {
        const bits = [];
        for (const g of Object.values(groups || {})) {
          const next = [...(g.tiers || [])]
            .sort((a, b) => a.quantity - b.quantity)
            .find((t) => g.qty < t.quantity);
          if (next) bits.push(`Sumá ${next.quantity - g.qty} más → pack ${formatARS(next.price)}`);
        }
        tierEl.textContent = bits[0] || (items.length ? 'Precio live del evento.' : '');
      }
    }

    if (!body) return;
    if (!items.length) {
      body.innerHTML = '<div class="cart-empty">Todavía no hay fotos.</div>';
      return;
    }

    body.innerHTML = items
      .map((item) => {
        const live = item.albumId ? albumPrices[item.albumId] : null;
        const unit = Number(live?.unit) || Number(item.unitPrice) || 0;
        const code = item.code || String(item.id || '').replace(/-/g, '').slice(0, 8).toUpperCase();
        return `
      <div class="cart-item" data-id="${item.id}">
        <img src="${item.thumb || item.src}" alt="" width="72" height="72" loading="lazy" />
        <div class="info">
          <strong>${item.albumName || 'Foto'}</strong>
          <span class="photo-code">#${code}</span>
          <span>${unit ? formatARS(unit) + ' · ' : ''}${formatLabel(item.format)}</span>
        </div>
        <button type="button" class="remove" data-remove="${item.id}">Quitar</button>
      </div>`;
      })
      .join('');

    body.querySelectorAll('[data-remove]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-remove');
        if (id) removeFromCart(id);
      });
    });
  }

  document.querySelectorAll('[data-open-cart]').forEach((btn) => btn.addEventListener('click', openCart));
  document.querySelectorAll('[data-close-cart]').forEach((btn) => btn.addEventListener('click', closeCart));
  backdrop?.addEventListener('click', closeCart);
  window.addEventListener('soleph:cart', () => {
    refreshPrices().then(render);
  });
  window.addEventListener('soleph:open-cart', openCart);
  render();
  refreshPrices().then(render);

  window.__solephOpenCart = openCart;
</script>
